/* 乐龄出行 - 暖橙活力风全局样式 */

page, view, text, button, input, image {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

page {
  background-color: #FFF9F2;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 32rpx;
  color: #2D3142;
  line-height: 1.5;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + 140rpx + env(safe-area-inset-bottom));
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D3142;
  margin-bottom: 24rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
  border-radius: 50rpx;
  padding: 28rpx 48rpx;
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  border: none;
  width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.3);
  box-sizing: border-box;
  display: block;
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.btn-secondary {
  background: #FFF2E6;
  color: #FF8C42;
  border-radius: 50rpx;
  padding: 28rpx 48rpx;
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  border: none;
  box-sizing: border-box;
  display: block;
}

.btn-secondary:active {
  opacity: 0.8;
}

.btn-danger {
  background: #EF476F;
  color: #ffffff;
  border-radius: 50rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border: none;
  box-sizing: border-box;
  display: block;
}

.btn-danger:active {
  opacity: 0.85;
}

.btn-outline {
  background: #ffffff;
  color: #FF8C42;
  border-radius: 50rpx;
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border: 2rpx solid #FF8C42;
  box-sizing: border-box;
  display: block;
}

.btn-outline:active {
  background: #FFF9F2;
}

/* 表单 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 30rpx;
  color: #4A4E5A;
  margin-bottom: 16rpx;
  display: block;
  font-weight: bold;
}

.form-input {
  background: #FFF9F2;
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 34rpx;
  color: #2D3142;
  border: 2rpx solid #F3E5D8;
  box-sizing: border-box;
  width: 100%;
}

.form-input:focus {
  border-color: #FF8C42;
}

.form-select {
  background: #FFF9F2;
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 34rpx;
  color: #2D3142;
  border: 2rpx solid #F3E5D8;
  box-sizing: border-box;
  width: 100%;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  font-weight: bold;
}

.tag-success {
  background: #E6FAF4;
  color: #06D6A0;
}

.tag-warning {
  background: #FFF4E0;
  color: #FF8C42;
}

.tag-danger {
  background: #FFEBEF;
  color: #EF476F;
}

.tag-info {
  background: #FFF2E6;
  color: #FF8C42;
}

/* 布局工具类 */
.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: #FF8C42;
}

.text-danger {
  color: #EF476F;
}

.text-success {
  color: #06D6A0;
}

.text-warning {
  color: #FFB627;
}

.text-gray {
  color: #6B7280;
}

.text-white {
  color: #ffffff;
}

.text-sm {
  font-size: 26rpx;
}

.text-md {
  font-size: 30rpx;
}

.text-lg {
  font-size: 36rpx;
}

.text-xl {
  font-size: 44rpx;
}

.text-xxl {
  font-size: 56rpx;
}

.font-bold {
  font-weight: bold;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}

.mt-40 {
  margin-top: 40rpx;
}

.mb-40 {
  margin-bottom: 40rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.ml-20 {
  margin-left: 20rpx;
}

.p-30 {
  padding: 30rpx;
}

.radius-20 {
  border-radius: 20rpx;
}

.radius-28 {
  border-radius: 28rpx;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 图标按钮 */
.icon-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.15);
}

.icon-btn:active {
  opacity: 0.8;
}

/* 价格 */
.price {
  color: #FF8C42;
  font-weight: bold;
}

.price-unit {
  font-size: 28rpx;
}

.price-value {
  font-size: 48rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #F3E5D8;
  margin: 24rpx 0;
}

/* 安全提示 */
.safety-tip {
  background: #FFF4E0;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
}

.safety-tip-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.safety-tip-text {
  font-size: 28rpx;
  color: #9A5B2E;
}

/* 页面标题 */
.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2D3142;
}

.page-subtitle {
  font-size: 28rpx;
  color: #6B7280;
  margin-top: 12rpx;
}

/* 状态条 */
.status-pill {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 12rpx;
  font-weight: bold;
}

.empty-hint {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #FFF2E6 25%, #FFE8D6 50%, #FFF2E6 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* 步骤指示器 */
.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E5E7EB;
}

.step-dot.active {
  background: #FF8C42;
  box-shadow: 0 0 0 8rpx rgba(255, 140, 66, 0.2);
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: #E5E7EB;
  margin: 0 16rpx;
}

.step-line.active {
  background: #FF8C42;
}

/* 顶部渐变装饰 */
.header-gradient {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 0 0 40rpx 40rpx;
  padding: 40rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
  color: #ffffff;
}

/* 通用 section */
.section-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #2D3142;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-more {
  font-size: 28rpx;
  color: #FF8C42;
  font-weight: bold;
}
