/* 全局配色系统 - 蓝白清爽版 */
page, view, text, button, input, image {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

page {
  background-color: #F8FAFE;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 38rpx;
  color: #2C3E5A;
  line-height: 1.5;
  --tabbar-height: 120rpx;
  --safe-bottom: env(safe-area-inset-bottom);
  --safe-top: env(safe-area-inset-top);
  --primary: #5B8DEF;
  --primary-dark: #4A7AD9;
  --text-primary: #2C3E5A;
  --text-secondary: #7A8BA0;
  --text-light: #B5C3D4;
  --bg-white: #FFFFFF;
  --bg-warm: #F8FAFE;
  --border: #E8ECF2;
}

.container {
  padding: 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Flex子元素保护 - 防止文本溢出 */
.flex-1 {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.flex-col-1 {
  flex: 1;
  min-width: 0;
}

/* 文本截断保护 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 安全区底部间距 */
.safe-bottom {
  padding-bottom: calc(var(--tabbar-height) + var(--safe-bottom) + 20rpx);
}

/* 安全区顶部间距 */
.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 60rpx);
}

/* 固定底部元素避让tabbar */
.fixed-bottom-tabbar {
  bottom: calc(var(--tabbar-height) + var(--safe-bottom));
}

/* 通用卡片标题 */

.card {
  background: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2C3E5A;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: #5B8DEF;
  color: #FFFFFF;
  padding: 28rpx;
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  display: block;
  box-shadow: 0 4rpx 16rpx rgba(91, 141, 239, 0.3);
}

.btn-secondary {
  background: #FFFFFF;
  color: #5B8DEF;
  padding: 28rpx;
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid #5B8DEF;
  border-radius: 12rpx;
  box-sizing: border-box;
  display: block;
}

.btn-danger {
  background: #FFFFFF;
  color: #E53935;
  padding: 28rpx;
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid #E53935;
  border-radius: 12rpx;
