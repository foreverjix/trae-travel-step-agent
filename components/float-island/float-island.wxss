.float-island-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  pointer-events: none;
}

.float-island {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8ECF2;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: auto;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(91, 141, 239, 0.1);
}

.float-island.expanded {
  border-color: #5B8DEF;
  padding: 28rpx;
  border-radius: 24rpx;
}

.float-island.urgent {
  border-color: #E53935;
}

.float-island.urgent.expanded {
  border-color: #E53935;
}

.island-pulse {
  position: absolute;
  left: 16rpx;
  top: 24rpx;
  width: 16rpx;
  height: 16rpx;
  background: #5B8DEF;
  z-index: 10;
  animation: island-pulse-urgent 1.5s infinite;
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(91, 141, 239, 0.5);
}

@keyframes island-pulse-urgent {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1);
  }
}

.island-content {
  width: 100%;
}

.island-short {
  display: flex;
  align-items: center;
  min-height: 140rpx;
  padding: 16rpx 24rpx;
}

.short-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.short-route-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.short-route {
  font-size: 38rpx;
  font-weight: 500;
  color: #2C3E5A;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.short-time {
  font-size: 30rpx;
  font-weight: 600;
  color: #5B8DEF;
  flex-shrink: 0;
  background: #FFE0D0;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.short-mid-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.short-train {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C3E5A;
  background: #F5F0EB;
  padding: 6rpx 16rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 12rpx;
}

.short-gate {
  font-size: 28rpx;
  color: #7A8BA0;
  font-weight: 500;
}

.short-seat {
  font-size: 28rpx;
  color: #7A8BA0;
  font-weight: 500;
}

.short-bottom-row {
  display: flex;
  align-items: center;
}

.short-plate {
  font-size: 26rpx;
  color: #B5C3D4;
  white-space: nowrap;
}

.island-expanded {
  width: 100%;
}

.expanded-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #E8ECF2;
}

.expanded-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #2C3E5A;
}

.expanded-close {
  padding: 12rpx 20rpx;
  background: #F5F0EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #7A8BA0;
  border: 1rpx solid #E8ECF2;
  border-radius: 12rpx;
}

.expanded-main {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.location-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #F5F0EB;
  border: 1rpx solid #E8ECF2;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}

.location-text {
  font-size: 28rpx;
  color: #7A8BA0;
  font-weight: 500;
  flex: 1;
}

.location-btn {
  font-size: 28rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  padding: 10rpx 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(91, 141, 239, 0.3);
}

.first-segment-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #F5F0EB;
  border: 1rpx solid #E8ECF2;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
}

.seg-bar-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C3E5A;
}

.seg-bar-tabs {
  display: flex;
  gap: 16rpx;
}

.seg-tab {
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: #FFFFFF;
  color: #7A8BA0;
  border: 1rpx solid #E8ECF2;
  border-radius: 12rpx;
}

.seg-tab.active {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #FFFFFF;
  border-color: #5B8DEF;
}

.trip-progress {
  padding: 28rpx 24rpx;
  background: #F5F0EB;
  border: 1rpx solid #E8ECF2;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 16rpx;
}

.prog-row {
  display: flex;
  align-items: flex-start;
  min-width: 100%;
}

.prog-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 140rpx;
  position: relative;
  z-index: 2;
}

.prog-circle {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
  background: #B5C3D4;
  border: 4rpx solid #ffffff;
  transition: all 0.3s ease;
  border-radius: 50%;
}

.prog-circle.start {
  background: #5B8DEF;
}

.prog-circle.station {
  background: #7A8BA0;
}

.prog-circle.end {
  background: #5B8DEF;
}

.prog-icon-text {
  font-size: 26rpx;
  font-weight: 500;
}

.prog-check {
  font-size: 26rpx;
  font-weight: 500;
}

.prog-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C3E5A;
  white-space: nowrap;
  display: inline-block;
}

.prog-name-wrap {
  width: 140rpx;
  overflow: hidden;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.3;
}

.prog-time {
  font-size: 24rpx;
  color: #B5C3D4;
  margin-top: 6rpx;
  font-weight: 400;
}

.prog-node.current .prog-circle {
  transform: scale(1.2);
  animation: progPulse 1.5s ease-in-out infinite;
}

.prog-node.current .prog-name {
  color: #2C3E5A;
  font-weight: 700;
}

.prog-node.done .prog-circle {
  background: #5B8DEF;
}

.prog-node.done .prog-name {
  color: #7A8BA0;
}

@keyframes progPulse {
  0%, 100% { transform: scale(1.2); }
  50% { transform: scale(1.35); }
}

.prog-segment {
  flex: 1;
  min-width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding-top: 32rpx;
  flex-shrink: 0;
  width: 140rpx;
}

.prog-segment::before {
  content: '';
  position: absolute;
  top: 36rpx;
  left: -20rpx;
  right: -20rpx;
  height: 4rpx;
  background: #E8ECF2;
  z-index: 0;
}

.prog-segment.done::before {
  background: #5B8DEF;
}

.seg-icon {
  font-size: 26rpx;
  background: #FFFFFF;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E8ECF2;
  z-index: 1;
  position: relative;
  font-weight: 500;
  color: #2C3E5A;
  border-radius: 12rpx;
}

.prog-segment.done .seg-icon {
  border-color: #5B8DEF;
}

.seg-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #2C3E5A;
  margin-top: 10rpx;
  white-space: nowrap;
}

.seg-sub-wrap {
  width: 140rpx;
  overflow: hidden;
  margin-top: 4rpx;
  text-align: center;
}

.seg-sub {
  font-size: 24rpx;
  color: #B5C3D4;
  white-space: nowrap;
  display: inline-block;
}

.current-step-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #EEF4FC;
  border: 1rpx solid #D0E0F5;
  margin: 10rpx 0;
  border-radius: 16rpx;
}

.current-step-text {
  font-size: 30rpx;
  color: #2C3E5A;
  font-weight: 500;
  flex: 1;
}

.expanded-info {
  display: flex;
  justify-content: space-around;
  padding: 8rpx 0;
}

.info-item {
  text-align: center;
  flex: 1;
}

.info-label {
  font-size: 26rpx;
  color: #7A8BA0;
  display: block;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 34rpx;
  font-weight: 500;
  color: #2C3E5A;
  display: block;
}

.expanded-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
}

.action-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.action-primary {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(91, 141, 239, 0.3);
}

.action-secondary {
  background: #FFFFFF;
  color: #5B8DEF;
  border: 2rpx solid #5B8DEF;
}

.action-tts {
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.action-tts.playing {
  background: linear-gradient(135deg, #E53935, #C62828);
  box-shadow: 0 4rpx 16rpx rgba(229, 57, 53, 0.3);
}

.action-tts-auto {
  background: #FFFFFF;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
}

.action-tts-auto.active {
  background: linear-gradient(135deg, #4CAF50, #388E3C);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.tts-btn-icon,
.tts-auto-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

.island-enter {
  animation: island-enter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes island-enter {
  0% {
    opacity: 0;
    transform: translateY(-100rpx) scale(0.8);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 响应式适配 - 小屏设备 */
.float-island.device-small {
  left: 16rpx;
  right: 16rpx;
  padding: 16rpx 20rpx;
}

.float-island.device-small.expanded {
  padding: 20rpx;
}

.float-island.device-small .island-short-info {
  font-size: 26rpx;
}

.float-island.device-small .short-route {
  font-size: 24rpx;
}

.float-island.device-small .short-time {
  font-size: 26rpx;
}

/* 响应式适配 - 大屏设备 */
.float-island.device-large {
  left: 32rpx;
  right: 32rpx;
}

.float-island.device-large .island-short-info {
  font-size: 30rpx;
}

.float-island.device-large .short-route {
  font-size: 28rpx;
}

.float-island.device-large .short-time {
  font-size: 30rpx;
}

/* 响应式适配 - 超大屏设备 */
.float-island.device-xlarge {
  left: 40rpx;
  right: 40rpx;
  padding: 24rpx 32rpx;
}

.float-island.device-xlarge.expanded {
  padding: 32rpx;
}

.float-island.device-xlarge .island-short-info {
  font-size: 32rpx;
}

.float-island.device-xlarge .short-route {
  font-size: 30rpx;
}

.float-island.device-xlarge .short-time {
  font-size: 32rpx;
}

/* 展开内容的最大高度限制，防止超出屏幕 */
.float-island.expanded .island-detail {
  max-height: 50vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.float-island.device-small.expanded .island-detail {
  max-height: 45vh;
}

.float-island.device-xlarge.expanded .island-detail {
  max-height: 55vh;
}

/* 安全区适配 */
.safe-bottom-padding {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
