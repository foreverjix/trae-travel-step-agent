<view class="float-island-container" wx:if="{{visible}}">
  <view class="float-island {{expanded ? 'expanded' : ''}} {{isUrgent ? 'urgent' : ''}} device-{{deviceType}}" style="top: {{statusBarHeight}}px;">
    <view class="island-pulse" wx:if="{{isUrgent && !expanded}}"></view>
    
    <view class="island-content">
      <view class="island-short" wx:if="{{!expanded}}" bindtap="toggleExpand">
        <view class="short-info">
          <view class="short-route-row">
            <text class="short-route">{{trip.from}} → {{trip.to}}</text>
            <text class="short-time">{{trip.departureTime}}</text>
          </view>
          <view class="short-mid-row">
            <text class="short-train" wx:if="{{trip.trainNo || trip.name}}">{{trip.trainNo || trip.name}}</text>
            <text class="short-gate" wx:if="{{trip.gate}}">{{trip.gate}}</text>
            <text class="short-seat" wx:if="{{trip.seat}}">座位{{trip.seat}}</text>
          </view>
          <view class="short-bottom-row">
            <text class="short-plate" wx:if="{{trip.plate || (trip.steps && trip.steps[0] && trip.steps[0].plate)}}">接站车牌 {{trip.plate || (trip.steps && trip.steps[0] && trip.steps[0].plate)}}</text>
          </view>
        </view>
      </view>
      
      <view class="island-expanded" wx:else>
        <view class="expanded-header">
          <text class="expanded-title">今日行程</text>
          <view class="expanded-close" catchtap="closeIsland">关闭</view>
        </view>
        
        <view class="expanded-main">
          <view class="location-bar">
            <text class="location-text">当前位置：{{currentLocation || '定位中...'}}</text>
            <view class="location-btn" bindtap="locateSelf">定位</view>
          </view>

          <view class="first-segment-bar" wx:if="{{!isLocked && processedTrip && processedTrip.steps && processedTrip.steps[0] && processedTrip.steps[0].isFirstSegment}}">
            <text class="seg-bar-label">去车站方式：</text>
            <view class="seg-bar-tabs">
              <view class="seg-tab {{firstSegmentType === 'taxi' ? 'active' : ''}}" data-type="taxi" bindtap="switchFirstSegment">
                打车
              </view>
              <view class="seg-tab {{firstSegmentType === 'bus' ? 'active' : ''}}" data-type="bus" bindtap="switchFirstSegment">
                公交
              </view>
            </view>
          </view>

          <view class="trip-progress" wx:if="{{processedTrip && processedTrip.steps && processedTrip.steps.length}}">
            <view class="prog-row">
              <view class="prog-node {{currentStepIndex >= 0 ? 'current' : ''}}">
                <view class="prog-circle start">
                  <text class="prog-icon-text">起</text>
                </view>
                <view class="prog-name-wrap">
                  <text class="prog-name">{{processedTrip.from}}　{{processedTrip.from}}</text>
                </view>
                <text class="prog-time">{{processedTrip.steps[0].time}}</text>
              </view>

              <block wx:for="{{processedTrip.steps}}" wx:key="index" wx:for-index="stepIdx">
                <view class="prog-segment {{item.status === 'done' ? 'done' : ''}}">
                  <text class="seg-icon">
                    <text wx:if="{{item.type === 'taxi'}}">打车</text>
                    <text wx:elif="{{item.type === 'bus'}}">公交</text>
                    <text wx:elif="{{item.type === 'train'}}">高铁</text>
                    <text wx:elif="{{item.type === 'subway'}}">地铁</text>
                    <text wx:elif="{{item.type === 'walk'}}">步行</text>
                    <text wx:else>行程</text>
                  </text>
                  <text class="seg-label">{{item.typeName}}</text>
                  <view class="seg-sub-wrap">
                    <text class="seg-sub">{{item.subText}}　{{item.subText}}</text>
                  </view>
                </view>

                <view class="prog-node {{item.status === 'done' ? 'done' : ''}} {{currentStepIndex === stepIdx + 1 ? 'current' : ''}}">
                  <view class="prog-circle {{stepIdx === processedTrip.steps.length - 1 ? 'end' : 'station'}}">
                    <text wx:if="{{item.status === 'done'}}" class="prog-check">完成</text>
                    <text wx:elif="{{stepIdx === processedTrip.steps.length - 1}}" class="prog-icon-text">终</text>
                    <text wx:else class="prog-icon-text">换</text>
                  </view>
                  <view class="prog-name-wrap">
                    <text class="prog-name">{{item.endLocation}}　{{item.endLocation}}</text>
                  </view>
                  <text class="prog-time">{{item.time}}</text>
                </view>
              </block>
            </view>
          </view>

          <view class="current-step-banner" wx:if="{{currentStepText}}">
            <text class="current-step-text">{{currentStepText}}</text>
          </view>

          <view class="expanded-info">
            <view class="info-item">
              <text class="info-label">车次</text>
              <text class="info-value">{{trip.name}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">发车</text>
              <text class="info-value">{{trip.departureTime}}</text>
            </view>
          </view>

          <view class="expanded-info">
            <view class="info-item">
              <text class="info-label">座位</text>
              <text class="info-value">{{trip.seat || '查看详情'}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">接站车牌</text>
              <text class="info-value">{{trip.plate || (trip.steps && trip.steps[0] && trip.steps[0].plate) || '查看详情'}}</text>
            </view>
          </view>
        </view>
        
        <view class="expanded-actions">
          <view class="action-btn action-tts {{isTtsPlaying ? 'playing' : ''}}" bindtap="toggleTtsPlay">
            <text class="tts-btn-icon">{{isTtsPlaying ? '⏸' : '🔊'}}</text>
            <text>{{isTtsPlaying ? '停止播报' : '语音播报'}}</text>
          </view>
          <view class="action-btn action-tts-auto {{isTtsAuto ? 'active' : ''}}" bindtap="toggleTtsAuto">
            <text class="tts-auto-icon">🚶</text>
            <text>{{isTtsAuto ? '行进播报中' : '行进播报'}}</text>
          </view>
        </view>
        
        <view class="expanded-actions">
          <view class="action-btn action-secondary" bindtap="saveCard">保存卡片</view>
          <view class="action-btn action-primary" bindtap="goToDetail">查看详情</view>
        </view>
      </view>
    </view>
  </view>
</view>
