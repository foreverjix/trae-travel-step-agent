<view class="custom-tabbar">
  <view 
    wx:for="{{tabs}}" 
    wx:key="path" 
    class="tab-item {{currentPath === item.path ? 'active' : ''}}"
    bindtap="switchTab"
    data-path="{{item.path}}"
  >
    <view class="tab-icon">
      <text class="icon-emoji">{{item.icon}}</text>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>