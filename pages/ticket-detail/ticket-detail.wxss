.ticket-info-card {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 44rpx) 32rpx 48rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.ticket-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.ticket-type-tag {
  background: #2C3E5A;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
  font-weight: 500;
  border-radius: 4rpx;
}

.ticket-number {
  font-size: 40rpx;
  font-weight: 500;
}

.route-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.station-item {
  flex: 1;
  text-align: center;
}

.station-name {
  font-size: 32rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
}

.station-time {
  font-size: 44rpx;
  font-weight: 500;
}

.route-line {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.line-dot {
  width: 12rpx;
  height: 12rpx;
  background: #ffffff;
}

.line-path {
  flex: 1;
  width: 2rpx;
  background: #7A8BA0;
  margin: 12rpx 0;
}

.duration-info {
  text-align: center;
  background: #2C3E5A;
  padding: 16rpx;
}

.duration-text {
  font-size: 28rpx;
  font-weight: 500;
}

.seats-section {
  margin-bottom: 24rpx;
}

.seats-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.seat-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.seat-item.selected {
  background: #FFE0D0;
  border-color: #5B8DEF;
  border-width: 2rpx;
}

.seat-info {
  flex: 1;
}

.seat-type {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C3E5A;
  display: block;
  margin-bottom: 6rpx;
}

.seat-count {
  font-size: 24rpx;
  color: #7A8BA0;
}

.seat-price {
  margin-right: 16rpx;
}

.seat-price .price-unit {
  font-size: 26rpx;
  color: #2C3E5A;
  font-weight: 500;
}

.seat-price .price-value {
  font-size: 40rpx;
  font-weight: 500;
  color: #2C3E5A;
}

.seat-check {
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 16rpx;
}

.passenger-section {
  margin-bottom: 24rpx;
}

.passenger-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.passenger-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C3E5A;
  display: block;
  margin-bottom: 6rpx;
}

.passenger-id {
  font-size: 24rpx;
  color: #7A8BA0;
}

.passenger-tag {
  background: #EBF0F8;
  color: #2C3E5A;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 4rpx;
}

.add-passenger {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: #ffffff;
  border: 2rpx dashed #5B8DEF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.add-icon {
  font-size: 40rpx;
  color: #5B8DEF;
  margin-right: 12rpx;
}

.add-text {
  font-size: 30rpx;
  color: #2C3E5A;
  font-weight: 500;
}

.order-info-section {
  margin-bottom: 120rpx;
}

.order-info-list {
  display: flex;
  flex-direction: column;
}

.order-info-item {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
}

.order-info-item:last-child {
  border-bottom: none;
}

.order-info-item.total {
  padding-top: 24rpx;
  border-top: 2rpx solid #E8ECF2;
}

.info-label {
  font-size: 28rpx;
  color: #7A8BA0;
}

.info-value {
  font-size: 28rpx;
  color: #2C3E5A;
  font-weight: 500;
}

.info-value.price {
  color: #2C3E5A;
  font-size: 34rpx;
}

.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  border-top: 1rpx solid #E8ECF2;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.action-buttons .btn-secondary,
.action-buttons .btn-primary {
  flex: 1;
}

.btn-secondary {
  text-align: center;
  padding: 26rpx;
  background: #ffffff;
  color: #7A8BA0;
  font-size: 28rpx;
  border: 2rpx solid #5B8DEF;
  border-radius: 16rpx;
}

.btn-primary {
  text-align: center;
  padding: 26rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.price-summary {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
}

.summary-label {
  font-size: 26rpx;
  color: #7A8BA0;
  margin-right: 8rpx;
}

.summary-price {
  font-size: 40rpx;
  font-weight: 500;
  color: #2C3E5A;
}
