.volunteer-container {
  min-height: 100vh;
  background: #F8FAFE;
}

.page-header {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 56rpx) 32rpx 48rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  flex: 1;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-desc {
  display: block;
  font-size: 24rpx;
  color: #ffffff;
  opacity: 0.8;
  margin-top: 8rpx;
}

.love-points-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid #E8ECF2;
}

.love-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E5A;
}

.radar-section {
  background: #ffffff;
  padding: 24rpx;
  margin: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  border: 1rpx solid #E8ECF2;
}

.radar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.radar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.radar-count {
  font-size: 24rpx;
  color: #2C3E5A;
  background: #EBF0F8;
  padding: 8rpx 16rpx;
}

.radar-container {
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-bg {
  position: relative;
  width: 340rpx;
  height: 340rpx;
}

.radar-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: 1rpx solid #E8ECF2;
  border-radius: 50%;
}

.radar-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
  background: #ffffff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E8ECF2;
}

.center-label {
  font-size: 20rpx;
  color: #7A8BA0;
  margin-top: 4rpx;
}

.radar-volunteer {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.radar-volunteer .volunteer-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ffffff;
}

.radar-volunteer.online .volunteer-dot {
  background: #2C3E5A;
}

.radar-volunteer.offline .volunteer-dot {
  background: #B5C3D4;
}

.radar-volunteer .volunteer-name {
  font-size: 20rpx;
  color: #2C3E5A;
  white-space: nowrap;
  margin-top: 4rpx;
  font-weight: 500;
}

.radar-volunteer .volunteer-distance {
  font-size: 18rpx;
  color: #B5C3D4;
  white-space: nowrap;
}

.radar-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #7A8BA0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.legend-dot.online {
  background: #2C3E5A;
}

.legend-dot.offline {
  background: #B5C3D4;
}

.volunteer-list {
  padding: 0 24rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.list-count {
  font-size: 24rpx;
  color: #B5C3D4;
}

.volunteer-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #E8ECF2;
}

.volunteer-card.selected {
  border-color: #5B8DEF;
}

.volunteer-avatar {
  width: 96rpx;
  height: 96rpx;
  background: #2C3E5A;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  position: relative;
  margin-right: 20rpx;
}

.online-dot {
  width: 20rpx;
  height: 20rpx;
  background: #B5C3D4;
  border-radius: 8rpx;
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  border: 2rpx solid #ffffff;
}

.online-dot.online {
  background: #2C3E5A;
}

.volunteer-info {
  flex: 1;
}

.volunteer-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.volunteer-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.volunteer-distance {
  font-size: 24rpx;
  color: #2C3E5A;
}

.volunteer-address {
  display: block;
  font-size: 24rpx;
  color: #B5C3D4;
  margin-top: 8rpx;
}

.volunteer-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #2C3E5A;
  background: #EBF0F8;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}

.volunteer-stats {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.stat {
  font-size: 22rpx;
  color: #B5C3D4;
}

.volunteer-action {
  margin-left: 16rpx;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn.primary {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #ffffff;
}

.action-btn.secondary {
  background: #ffffff;
  color: #2C3E5A;
  border: 2rpx solid #5B8DEF;
}

.rewards-section {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  padding: 24rpx;
  margin: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.rewards-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.rewards-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.rewards-subtitle {
  font-size: 24rpx;
  color: #ffffff;
  opacity: 0.8;
}

.rewards-scroll {
  white-space: nowrap;
}

.rewards-list {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 10rpx;
}

.reward-item {
  width: 200rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  padding: 20rpx 16rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  white-space: normal;
  border: 1rpx solid #E8ECF2;
}

.reward-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3E5A;
  text-align: center;
}

.reward-desc {
  font-size: 22rpx;
  color: #B5C3D4;
  text-align: center;
  margin-top: 4rpx;
}

.reward-price {
  margin-top: 12rpx;
  text-align: center;
}

.reward-price .price-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E5A;
}

.reward-price .price-label {
  font-size: 20rpx;
  color: #B5C3D4;
}

.reward-btn {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #ffffff;
  padding: 12rpx 32rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.certification-section {
  background: #ffffff;
  padding: 24rpx;
  margin: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  border: 1rpx solid #E8ECF2;
}

.certification-header {
  margin-bottom: 20rpx;
}

.certification-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.certification-subtitle {
  display: block;
  font-size: 24rpx;
  color: #B5C3D4;
  margin-top: 8rpx;
}

.certification-list {
  padding: 0 8rpx;
}

.certification-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
  opacity: 0.5;
}

.certification-item.certified {
  opacity: 1;
}

.certification-item:last-child {
  border-bottom: none;
}

.cert-info {
  flex: 1;
}

.cert-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.cert-desc {
  display: block;
  font-size: 24rpx;
  color: #B5C3D4;
  margin-top: 4rpx;
}

.cert-status {
  background: #EBF0F8;
  padding: 8rpx 20rpx;
  border-radius: 4rpx;
}

.cert-status text {
  font-size: 24rpx;
  color: #7A8BA0;
}

.certification-item.certified .cert-status {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
}

.certification-item.certified .cert-status text {
  color: #ffffff;
}

.achievements-section {
  background: #ffffff;
  padding: 24rpx;
  margin: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  border: 1rpx solid #E8ECF2;
}

.achievements-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.achievements-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.achievements-subtitle {
  font-size: 24rpx;
  color: #B5C3D4;
}

.achievements-scroll {
  white-space: nowrap;
}

.achievements-list {
  display: inline-flex;
  gap: 20rpx;
  padding-bottom: 10rpx;
}

.achievement-item {
  width: 160rpx;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  white-space: normal;
}

.achievement-item.unlocked {
  background: #ffffff;
  border: 1rpx solid #5B8DEF;
}

.achievement-item.locked {
  background: #EBF0F8;
  opacity: 0.6;
}

.achievement-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2C3E5A;
  text-align: center;
  margin-bottom: 8rpx;
}

.achievement-desc {
  font-size: 20rpx;
  color: #B5C3D4;
  text-align: center;
  margin-bottom: 8rpx;
}

.achievement-points {
  font-size: 22rpx;
  color: #2C3E5A;
  font-weight: 500;
}

.rank-section {
  padding: 24rpx;
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  border-top: 1rpx solid #E8ECF2;
}

.rank-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.rank-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E5A;
}

.rank-subtitle {
  display: block;
  font-size: 24rpx;
  color: #B5C3D4;
  margin-top: 8rpx;
}

.rank-list {
  padding: 0 8rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 48rpx;
  height: 48rpx;
  background: #EBF0F8;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #7A8BA0;
  margin-right: 16rpx;
}

.rank-num.top1 {
  background: #2C3E5A;
  color: #ffffff;
}

.rank-num.top2 {
  background: #7A8BA0;
  color: #ffffff;
}

.rank-num.top3 {
  background: #B5C3D4;
  color: #ffffff;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  background: #2C3E5A;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-right: 16rpx;
}

.rank-info {
  flex: 1;
}

.rank-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.rank-level {
  font-size: 22rpx;
  color: #2C3E5A;
  background: #EBF0F8;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.rank-count {
  display: block;
  font-size: 24rpx;
  color: #B5C3D4;
  margin-top: 8rpx;
}

.rank-points {
  text-align: right;
}

.points-num {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E5A;
}

.points-label {
  display: block;
  font-size: 22rpx;
  color: #B5C3D4;
}

.share-section {
  margin-top: 24rpx;
}

.share-btn {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.share-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.share-reward {
  font-size: 24rpx;
  color: #ffffff;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}

.volunteer-detail {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.detail-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  padding: 32rpx;
  padding-bottom: 48rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.detail-avatar {
  width: 120rpx;
  height: 120rpx;
  background: #2C3E5A;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  position: relative;
  margin-right: 24rpx;
}

.detail-info {
  flex: 1;
}

.detail-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E5A;
}

.detail-address {
  display: block;
  font-size: 26rpx;
  color: #7A8BA0;
  margin-top: 8rpx;
}

.detail-distance {
  display: block;
  font-size: 24rpx;
  color: #2C3E5A;
  margin-top: 8rpx;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  background: #EBF0F8;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #7A8BA0;
}

.detail-section {
  margin-bottom: 28rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  color: #B5C3D4;
  margin-bottom: 16rpx;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.service-tag {
  font-size: 26rpx;
  color: #2C3E5A;
  background: #EBF0F8;
  padding: 10rpx 24rpx;
  border-radius: 4rpx;
}

.rating-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rating {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.completed {
  font-size: 24rpx;
  color: #B5C3D4;
}

.detail-actions {
  display: flex;
  gap: 24rpx;
}

.detail-actions .action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.help-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 101;
}

.help-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.help-card {
  position: relative;
  width: 90%;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  padding: 32rpx;
  z-index: 102;
  border: 1rpx solid #E8ECF2;
}

.help-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.help-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E5A;
}

.help-close {
  width: 56rpx;
  height: 56rpx;
  background: #EBF0F8;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #7A8BA0;
}

.help-section {
  margin-bottom: 28rpx;
}

.help-label {
  display: block;
  font-size: 26rpx;
  color: #B5C3D4;
  margin-bottom: 16rpx;
}

.help-type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.type-item {
  background: #EBF0F8;
  border-radius: 8rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  border: 1rpx solid #E8ECF2;
}

.type-item.selected {
  border-color: #5B8DEF;
  background: #ffffff;
}

.type-name {
  font-size: 24rpx;
  color: #2C3E5A;
  display: block;
  margin-bottom: 6rpx;
}

.type-points {
  font-size: 20rpx;
  color: #2C3E5A;
}

.help-textarea {
  width: 100%;
  height: 160rpx;
  background: #EBF0F8;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #2C3E5A;
  border: 1rpx solid #E8ECF2;
}

.help-footer {
  display: flex;
  gap: 24rpx;
}

.help-footer .action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}
