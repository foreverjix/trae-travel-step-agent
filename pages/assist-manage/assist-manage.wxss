.header-gradient {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 44rpx) 32rpx 48rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.header-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 14rpx;
  flex-shrink: 0;
}

.header-back text {
  font-size: 44rpx;
  color: #ffffff;
  font-weight: bold;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.accounts-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.account-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #E8ECF2;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.account-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.account-avatar {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffffff;
  font-weight: bold;
  flex-shrink: 0;
}

.account-detail {
  flex: 1;
}

.account-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.account-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #2C3E5A;
}

.account-relation {
  font-size: 24rpx;
  color: #2C3E5A;
  background: #EBF0F8;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.account-phone {
  font-size: 30rpx;
  color: #7A8BA0;
  display: block;
  margin-bottom: 8rpx;
}

.account-time {
  font-size: 24rpx;
  color: #B5C3D4;
}

.account-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8ECF2;
}

.action-btn {
  padding: 18rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.action-call {
  background: #EBF0F8;
  color: #2C3E5A;
  flex: 1;
  border: 1rpx solid #E8ECF2;
}

.action-delete {
  background: #ffffff;
  color: #2C3E5A;
  border: 1rpx solid #E8ECF2;
}

.tips-card {
  background: #F8FAFE;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 30rpx;
  border: 1rpx solid #E8ECF2;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2C3E5A;
}

.tips-list {
  display: flex;
  flex-direction: column;
}

.tips-item {
  font-size: 28rpx;
  color: #7A8BA0;
  line-height: 1.8;
}
