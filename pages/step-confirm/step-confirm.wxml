<view class="container">
  <!-- 方案概览 -->
  <view class="header-gradient">
    <view class="trip-overview">
      <view class="trip-cities">
        <text class="trip-city">{{from}}</text>
        <view class="trip-arrow">→</view>
        <text class="trip-city">{{to}}</text>
      </view>
      <text class="trip-date">{{date}} 出发 · {{plan.totalTime}} · 共{{plan.totalPrice}}元</text>
    </view>
  </view>

  <!-- 步骤条 -->
  <view class="step-bar">
    <view wx:for="{{steps}}" wx:key="index" class="step-node">
      <view class="step-circle {{index <= currentStep ? 'active' : ''}}">{{index + 1}}</view>
      <text class="step-label {{index <= currentStep ? 'active' : ''}}">{{item.title}}</text>
      <view wx:if="{{index < steps.length - 1}}" class="step-connector {{index < currentStep ? 'active' : ''}}"></view>
    </view>
  </view>

  <!-- 当前步骤详情 -->
  <view class="step-detail-card">
    <view class="step-detail-header">
      <view class="step-icon-large">{{currentStepData.icon}}</view>
      <view class="step-title-group">
        <text class="step-main-title">{{currentStepData.title}}</text>
        <text class="step-subtitle">{{currentStepData.subtitle}}</text>
      </view>
    </view>

    <view class="step-content">
      <view class="info-row">
        <text class="info-label">行程</text>
        <text class="info-value">{{currentStepData.route}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">时间</text>
        <text class="info-value">{{currentStepData.time}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">费用</text>
        <text class="info-value price">¥{{currentStepData.price}}</text>
      </view>
      <view class="info-row" wx:if="{{currentStepData.seat}}">
        <text class="info-label">座位</text>
        <text class="info-value">{{currentStepData.seat}}</text>
      </view>
      <view class="info-row" wx:if="{{currentStepData.driver}}">
        <text class="info-label">司机</text>
        <text class="info-value">{{currentStepData.driver}}</text>
      </view>
    </view>

    <view class="confirm-tip">
      <text class="confirm-tip-icon">✋</text>
      <text class="confirm-tip-text">请仔细核对以上信息，确认无误后再点击"我确认"</text>
    </view>
  </view>

  <!-- 已确认步骤 -->
  <view class="confirmed-section" wx:if="{{confirmedSteps.length > 0}}">
    <text class="section-title">已确认</text>
    <view class="confirmed-list">
      <view class="confirmed-item" wx:for="{{confirmedSteps}}" wx:key="index">
        <text class="confirmed-icon">{{item.icon}}</text>
        <view class="confirmed-info">
          <text class="confirmed-name">{{item.title}}</text>
          <text class="confirmed-detail">{{item.route}}</text>
        </view>
        <text class="confirmed-price">¥{{item.price}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="footer-actions">
    <view class="btn-secondary" bindtap="goBack">我再想想</view>
    <view class="btn-primary" bindtap="confirmStep">
      {{isLastStep ? '确认并下单' : '我确认，下一步'}}
    </view>
  </view>
</view>