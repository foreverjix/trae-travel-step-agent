.trip-overview {
  text-align: center;
  padding: 20rpx 0;
}

.trip-cities {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.trip-city {
  font-size: 48rpx;
  font-weight: bold;
}

.trip-arrow {
  font-size: 40rpx;
  margin: 0 30rpx;
  opacity: 0.9;
}

.trip-date {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
}

.step-bar {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.step-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}

.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F3E5D8;
  color: #9CA3AF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.step-circle.active {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
}

.step-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.step-label.active {
  color: #FF8C42;
  font-weight: bold;
}

.step-connector {
  position: absolute;
  top: 28rpx;
  right: -50%;
  width: 100%;
  height: 4rpx;
  background: #F3E5D8;
}

.step-connector.active {
  background: linear-gradient(90deg, #FF8C42 0%, #FFB627 100%);
}

.step-detail-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.step-detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #F3E5D8;
}

.step-icon-large {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FFF2E6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.step-title-group {
  flex: 1;
}

.step-main-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 8rpx;
}

.step-subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

.step-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
}

.info-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 32rpx;
  color: #2D3142;
  font-weight: bold;
}

.info-value.price {
  color: #FF8C42;
}

.confirm-tip {
  background: #FFF4E0;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.confirm-tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.confirm-tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #9A5B2E;
  line-height: 1.5;
}

.confirmed-section {
  margin-bottom: 24rpx;
}

.confirmed-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.confirmed-item {
  background: #E6FAF4;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.confirmed-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.confirmed-info {
  flex: 1;
}

.confirmed-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 6rpx;
}

.confirmed-detail {
  font-size: 26rpx;
  color: #6B7280;
}

.confirmed-price {
  font-size: 32rpx;
  color: #06D6A0;
  font-weight: bold;
}

.footer-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.footer-actions .btn-secondary,
.footer-actions .btn-primary {
  flex: 1;
}
