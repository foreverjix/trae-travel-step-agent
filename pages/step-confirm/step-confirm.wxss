.container {
  padding: 0;
  background: #F8FAFE;
  min-height: 100vh;
}

.trip-header {
  text-align: center;
  padding: calc(env(safe-area-inset-top) + 56rpx) 32rpx 48rpx;
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  border-bottom: none;
}

.trip-header .trip-city {
  color: #ffffff;
}

.trip-header .trip-sep {
  color: rgba(255,255,255,0.7);
}

.trip-header .trip-date-info {
  color: rgba(255,255,255,0.9);
}

.trip-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.trip-city {
  font-size: 36rpx;
  font-weight: 500;
  color: #2C3E5A;
}

.trip-sep {
  font-size: 32rpx;
  margin: 0 24rpx;
  color: #B5C3D4;
}

.trip-sub {
  font-size: 24rpx;
  color: #7A8BA0;
}

.stepper {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  background: #ffffff;
  padding: 28rpx 24rpx;
  margin: 24rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  background: #EBF0F8;
  color: #B5C3D4;
  font-size: 24rpx;
  text-align: center;
  line-height: 44rpx;
  margin-bottom: 8rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 8rpx;
}

.step-num.active {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #ffffff;
  border-color: #5B8DEF;
}

.step-name {
  font-size: 22rpx;
  color: #B5C3D4;
  text-align: center;
}

.step-name.active {
  color: #2C3E5A;
  font-weight: 500;
}

.step-line {
  position: absolute;
  top: 22rpx;
  right: -50%;
  width: 100%;
  height: 1rpx;
  background: #E8ECF2;
}

.step-line.active {
  background: #5B8DEF;
}

.detail-card {
  background: #ffffff;
  margin: 0 24rpx 24rpx;
  border: 1rpx solid #E8ECF2;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.detail-head {
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.detail-type {
  display: inline-block;
  font-size: 22rpx;
  color: #7A8BA0;
  background: #EBF0F8;
  padding: 4rpx 16rpx;
  margin-bottom: 10rpx;
  border-radius: 4rpx;
}

.detail-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #2C3E5A;
}

.info-list {
  display: block;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
}

.info-row:last-child {
  border-bottom: none;
}

.info-key {
  width: 120rpx;
  font-size: 26rpx;
  color: #B5C3D4;
  flex-shrink: 0;
}

.info-val {
  flex: 1;
  font-size: 26rpx;
  color: #2C3E5A;
}

.info-val.price {
  font-weight: 500;
}

.notice {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F0EB;
  font-size: 24rpx;
  color: #B5C3D4;
}

.confirmed-block {
  margin: 0 24rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.confirmed-head {
  display: block;
  font-size: 26rpx;
  color: #7A8BA0;
  padding: 20rpx 24rpx 12rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.confirmed-list {
  padding: 0 24rpx;
}

.confirmed-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
}

.confirmed-row:last-child {
  border-bottom: none;
}

.confirmed-type {
  font-size: 22rpx;
  color: #7A8BA0;
  background: #EBF0F8;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 4rpx;
}

.confirmed-info {
  flex: 1;
}

.confirmed-title {
  display: block;
  font-size: 28rpx;
  color: #2C3E5A;
}

.confirmed-route {
  display: block;
  font-size: 24rpx;
  color: #B5C3D4;
  margin-top: 4rpx;
}

.confirmed-price {
  font-size: 28rpx;
  color: #2C3E5A;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.bottom-bar {
  display: flex;
  margin: 0 24rpx 40rpx;
  gap: 16rpx;
}

.btn-plain {
  flex: 1;
  text-align: center;
  padding: 26rpx;
  background: #ffffff;
  color: #7A8BA0;
  font-size: 28rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 16rpx;
}

.btn-main {
  flex: 1;
  text-align: center;
  padding: 26rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 16rpx;
}
