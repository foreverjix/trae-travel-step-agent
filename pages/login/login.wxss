/* 登录页输入框，覆盖全局样式 */
page .container .form-input,
page .container .form-item .form-input {
  background: #FFF9F2;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  color: #2D3142;
  border: 2rpx solid #F3E5D8;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  display: block;
  height: 96rpx;
  line-height: 96rpx;
}

.login-header {
  text-align: center;
  padding: 60rpx 20rpx 50rpx;
}

.logo-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(255, 140, 66, 0.3);
}

.logo-icon {
  font-size: 96rpx;
}

.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 30rpx;
  color: #6B7280;
}

.form-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
  width: 100%;
  box-sizing: border-box;
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-label {
  font-size: 30rpx;
  color: #4A4E5A;
  margin-bottom: 16rpx;
  display: block;
  font-weight: bold;
  width: 100%;
}

.code-input-group {
  display: flex;
  gap: 16rpx;
  width: 100%;
  align-items: stretch;
}

.code-input-group .code-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
}

.send-code-btn {
  padding: 0 28rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #ffffff;
  white-space: nowrap;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 66, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
}

.send-code-btn.disabled {
  background: #E5E7EB;
  box-shadow: none;
  color: #9CA3AF;
}

.agreement-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #F3E5D8;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #FF8C42;
  background: #FFF9F2;
}

.checkbox.checked {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-color: #FF8C42;
  color: #ffffff;
}

.agreement-text {
  font-size: 28rpx;
  color: #6B7280;
}

.agreement-link {
  font-size: 28rpx;
  color: #FF8C42;
  font-weight: bold;
}

.login-btn {
  font-size: 36rpx;
  padding: 32rpx;
}

.assist-card {
  background: #FFF9F2;
  border-radius: 28rpx;
  padding: 32rpx;
  text-align: center;
  border: 2rpx solid #FFE4D1;
}

.assist-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.assist-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 12rpx;
}

.assist-desc {
  font-size: 28rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.assist-btn {
  width: 100%;
}
