page {
  background-color: #F8FAFE;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

page .container .form-input,
page .container .form-item .form-input {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  color: #2C3E5A;
  border: 1rpx solid #E8ECF2;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  display: block;
  height: 96rpx;
  line-height: 96rpx;
}

.login-header {
  text-align: center;
  padding: calc(env(safe-area-inset-top) + 44rpx) 32rpx 48rpx;
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
}

.login-header .logo-box {
  background: rgba(255,255,255,0.25);
  border: 3rpx solid rgba(255,255,255,0.5);
}

.login-header .app-name {
  color: #ffffff;
}

.login-header .app-slogan {
  color: rgba(255,255,255,0.9);
}

.logo-box {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  border: 1rpx solid #5B8DEF;
}

.logo-text {
  font-size: 100rpx;
  color: #ffffff;
  font-weight: bold;
}

.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 30rpx;
  color: #7A8BA0;
}

.form-card {
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin: 0 0 24rpx;
  border: 1rpx solid #E8ECF2;
  width: 100%;
  box-sizing: border-box;
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-label {
  font-size: 32rpx;
  color: #7A8BA0;
  margin-bottom: 20rpx;
  display: block;
  font-weight: bold;
  width: 100%;
}

.code-input-group {
  display: flex;
  gap: 20rpx;
  width: 100%;
  align-items: stretch;
}

.code-input-group .code-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
}

.send-code-btn {
  padding: 0 36rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #ffffff;
  white-space: nowrap;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  flex-shrink: 0;
  border: 1rpx solid #5B8DEF;
}

.send-code-btn.disabled {
  background: #E8ECF2;
  color: #B5C3D4;
  border: 1rpx solid #E8ECF2;
}

.agreement-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 4rpx;
  border: 1rpx solid #E8ECF2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #2C3E5A;
  background: #ffffff;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #5B8DEF;
  border-color: #5B8DEF;
  color: #ffffff;
}

.agreement-text {
  font-size: 30rpx;
  color: #7A8BA0;
}

.agreement-link {
  font-size: 30rpx;
  color: #5B8DEF;
  font-weight: bold;
}

.login-btn {
  font-size: 36rpx;
  padding: 32rpx;
}

.assist-card {
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  border: 1rpx solid #E8ECF2;
}

.assist-header {
  margin-bottom: 16rpx;
}

.assist-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
}

.assist-desc {
  font-size: 30rpx;
  color: #7A8BA0;
  display: block;
  margin-bottom: 28rpx;
  line-height: 1.5;
}

.assist-btn {
  width: 100%;
}
