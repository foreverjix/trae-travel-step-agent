<view class="container">
  <view class="header">
    <text class="page-title">我的行程</text>
    <text class="page-subtitle">查看和管理所有出行订单</text>
  </view>

  <view class="contact-bar" wx:if="{{role === 'elder'}}" bindtap="quickContactChild">
    <text class="contact-icon">📞</text>
    <text class="contact-text">出行有疑问？一键联系子女</text>
    <text class="contact-arrow">›</text>
  </view>

  <view class="tabs">
    <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab {{currentTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending">出行中</view>
    <view class="tab {{currentTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">已结束</view>
    <view class="tab {{currentTab === 'cancelled' ? 'active' : ''}}" bindtap="switchTab" data-tab="cancelled">已取消</view>
  </view>

  <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
    <view class="order-card" wx:for="{{filteredOrders}}" wx:key="orderId">
      <view class="order-top">
        <view class="order-info">
          <text class="order-icon">{{item.type === 'train' ? '🚄' : (item.type === 'bus' ? '🚌' : '🚕')}}</text>
          <text class="order-title">{{item.orderTitle}}</text>
        </view>
        <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="order-route">
        <view class="route-item">
          <text class="route-label">出发</text>
          <text class="route-name">{{item.startStation || item.start}}</text>
        </view>
        <view class="route-line">
          <text class="route-arrow">↓</text>
        </view>
        <view class="route-item">
          <text class="route-label">到达</text>
          <text class="route-name">{{item.endStation || item.end}}</text>
        </view>
      </view>

      <view class="order-meta">
        <view class="meta-item" wx:if="{{item.name}}">
          <text class="meta-label">车次</text>
          <text class="meta-value">{{item.name}}</text>
        </view>
        <view class="meta-item" wx:if="{{item.departureTime}}">
          <text class="meta-label">出发</text>
          <text class="meta-value">{{item.departureTime}}</text>
        </view>
        <view class="meta-item" wx:if="{{item.seat}}">
          <text class="meta-label">座位</text>
          <text class="meta-value">{{item.seat}}</text>
        </view>
        <view class="meta-item" wx:if="{{item.plate}}">
          <text class="meta-label">车牌</text>
          <text class="meta-value">{{item.plate}}</text>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-date">{{item.date}}</text>
        <text class="order-price">¥{{item.price || 0}}</text>
      </view>

      <view class="order-actions">
        <view class="btn btn-outline" wx:if="{{item.status === 'booked'}}" catchtap="handleAction" data-action="change" data-order="{{item}}">换时间</view>
        <view class="btn btn-outline-red" wx:if="{{item.status === 'booked' || item.status === 'waiting' || item.status === 'picking'}}" catchtap="handleAction" data-action="cancel" data-order="{{item}}">取消订单</view>
        <view class="btn btn-outline-green" wx:if="{{item.status === 'completed'}}" catchtap="handleAction" data-action="confirm" data-order="{{item}}">确认完成</view>
        <view class="btn btn-primary" catchtap="goToDetail" data-order="{{item}}">查看详情</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="empty-icon">🚶</text>
    <text class="empty-text">{{emptyText}}</text>
    <view class="btn btn-primary empty-btn" bindtap="goBook">去预订出行</view>
  </view>

  <custom-tabbar current-path="/pages/orders/orders"></custom-tabbar>
  <ai-assistant aiEnabled="{{aiAssistantEnabled}}"></ai-assistant>
</view>
