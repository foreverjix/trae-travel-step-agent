page {
  background: #F5F8FC;
  min-height: 100vh;
}

.container {
  padding: 0 0 220rpx;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #7BA8F0, #5B8DEF);
  padding: calc(env(safe-area-inset-top) + 56rpx) 32rpx 40rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
}

.contact-bar {
  display: flex;
  align-items: center;
  background: #6B9BCE;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
}

.contact-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.contact-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.contact-arrow {
  font-size: 36rpx;
  color: rgba(255,255,255,0.75);
}

.tabs {
  display: flex;
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(91,141,239,0.08);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #7A8BA0;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab.active {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #FFFFFF;
}

.order-list {
  padding: 24rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(91,141,239,0.06);
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.order-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.order-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2C3E5A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.status-booked,
.status-waiting {
  background: #EEF4FC;
  color: #5B8DEF;
}

.status-picking,
.status-onway {
  background: #E6EEF9;
  color: #3A6BC4;
}

.status-completed {
  background: #E8F0FA;
  color: #4A7AD9;
}

.status-cancelled {
  background: #EDF0F5;
  color: #7A8BA0;
}

.order-route {
  background: #F2F6FC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.route-item {
  display: flex;
  align-items: center;
}

.route-label {
  font-size: 26rpx;
  color: #7A8BA0;
  width: 72rpx;
  font-weight: 700;
}

.route-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #2C3E5A;
}

.route-line {
  text-align: center;
  padding: 8rpx 0;
}

.route-arrow {
  font-size: 28rpx;
  color: #5B8DEF;
}

.order-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  background: #EBF0F8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
}

.meta-label {
  font-size: 22rpx;
  color: #7A8BA0;
  margin-bottom: 6rpx;
}

.meta-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #2C3E5A;
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-date {
  font-size: 28rpx;
  color: #7A8BA0;
  font-weight: 600;
}

.order-price {
  font-size: 40rpx;
  font-weight: 900;
  color: #3A6BC4;
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.2s;
}

.btn:active {
  transform: scale(0.96);
}

.btn-primary {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #FFFFFF;
}

.btn-outline {
  background: #FFFFFF;
  border: 2rpx solid #5B8DEF;
  color: #5B8DEF;
}

.btn-outline-red {
  background: #FFFFFF;
  border: 2rpx solid #A5B5CE;
  color: #7A8BA0;
}

.btn-outline-green {
  background: #FFFFFF;
  border: 2rpx solid #6B9BCE;
  color: #4A7AD9;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #4A5568;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 60%;
  margin: 0 auto;
}
