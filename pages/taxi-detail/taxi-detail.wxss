.status-card {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.25);
}

.status-icon-ring {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.status-icon {
  font-size: 72rpx;
}

.status-text {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

.route-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.route-content {
  position: relative;
  padding-left: 44rpx;
  margin-bottom: 24rpx;
}

.route-point {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.route-point:last-child {
  margin-bottom: 0;
}

.point-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.route-point.start .point-dot {
  background: #FF8C42;
  box-shadow: 0 0 0 8rpx rgba(255, 140, 66, 0.2);
}

.route-point.end .point-dot {
  background: #06D6A0;
  box-shadow: 0 0 0 8rpx rgba(6, 214, 160, 0.2);
}

.point-label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-right: 16rpx;
  width: 50rpx;
}

.point-text {
  font-size: 32rpx;
  color: #2D3142;
  font-weight: bold;
  flex: 1;
}

.route-line {
  position: absolute;
  left: 34rpx;
  top: 44rpx;
  width: 4rpx;
  height: calc(100% - 88rpx);
  background: linear-gradient(180deg, #FF8C42 0%, #FFB627 100%);
}

.route-info {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3E5D8;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.info-text {
  font-size: 30rpx;
  color: #6B7280;
  font-weight: bold;
}

.info-text.price {
  color: #FF8C42;
}

.driver-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.driver-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.driver-avatar {
  width: 100rpx;
  height: 100rpx;
  background: #FFF2E6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-icon {
  font-size: 56rpx;
}

.driver-info {
  flex: 1;
}

.driver-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 8rpx;
}

.driver-rating {
  display: flex;
  align-items: center;
}

.star {
  color: #FFB627;
  font-size: 28rpx;
}

.rating-value {
  font-size: 30rpx;
  color: #FFB627;
  margin-left: 8rpx;
  font-weight: bold;
}

.driver-call {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 66, 0.25);
}

.call-icon {
  font-size: 40rpx;
}

.vehicle-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFF9F2;
  border-radius: 20rpx;
}

.vehicle-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.vehicle-text {
  font-size: 32rpx;
  color: #2D3142;
  font-weight: bold;
}

.progress-section {
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 16rpx;
  background: #FFF2E6;
  border-radius: 8rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 8rpx;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
}

.step {
  text-align: center;
  flex: 1;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  background: #FFF2E6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9CA3AF;
  margin: 0 auto 8rpx;
  font-weight: bold;
}

.step.active .step-dot {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
}

.step-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

.step.active .step-text {
  color: #FF8C42;
  font-weight: bold;
}

.safety-section {
  background: #FFF9F2;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 120rpx;
  border: 2rpx solid #FFE4D1;
}

.safety-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.safety-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.safety-text {
  font-size: 28rpx;
  color: #9A5B2E;
}

.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  box-shadow: 0 -8rpx 24rpx rgba(255, 140, 66, 0.1);
  display: flex;
  gap: 20rpx;
  z-index: 100;
}

.footer-actions .btn-secondary,
.footer-actions .btn-primary {
  flex: 1;
}
