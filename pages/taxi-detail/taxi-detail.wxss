page {
  background-color: #F8FAFE;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.status-card {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 44rpx) 40rpx 48rpx;
  text-align: center;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.status-text {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 30rpx;
  color: #FFE0D0;
}

.route-card {
  background: #ffffff;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.route-content {
  position: relative;
  padding-left: 44rpx;
  margin-bottom: 24rpx;
}

.route-point {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.route-point:last-child {
  margin-bottom: 0;
}

.point-dot {
  width: 24rpx;
  height: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #2C3E5A;
  border: 4rpx solid #2C3E5A;
}

.route-point.start .point-dot {
  background: #ffffff;
  border: 4rpx solid #2C3E5A;
}

.route-point.end .point-dot {
  background: #2C3E5A;
  border: 4rpx solid #2C3E5A;
}

.point-label {
  font-size: 26rpx;
  color: #B5C3D4;
  margin-right: 16rpx;
  width: 50rpx;
}

.point-text {
  font-size: 34rpx;
  color: #2C3E5A;
  font-weight: bold;
  flex: 1;
}

.route-line {
  position: absolute;
  left: 34rpx;
  top: 48rpx;
  width: 4rpx;
  height: calc(100% - 96rpx);
  background: #2C3E5A;
}

.route-info {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid #E8ECF2;
}

.info-text {
  font-size: 32rpx;
  color: #7A8BA0;
  font-weight: bold;
}

.info-text.price {
  color: #2C3E5A;
}

.driver-card {
  background: #ffffff;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.driver-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 20rpx;
}

.driver-label {
  font-size: 30rpx;
  color: #2C3E5A;
  font-weight: bold;
  background: #EBF0F8;
  padding: 12rpx 20rpx;
  border: 1rpx solid #E8ECF2;
  flex-shrink: 0;
  border-radius: 4rpx;
}

.driver-info {
  flex: 1;
}

.driver-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 8rpx;
}

.driver-rating {
  display: flex;
  align-items: center;
}

.rating-value {
  font-size: 30rpx;
  color: #7A8BA0;
  font-weight: bold;
}

.driver-call {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
}

.call-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
}

.vehicle-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #EBF0F8;
  border: 1rpx solid #E8ECF2;
  border-radius: 8rpx;
}

.vehicle-text {
  font-size: 32rpx;
  color: #2C3E5A;
  font-weight: bold;
}

.progress-section {
  background: #ffffff;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.progress-bar {
  height: 16rpx;
  background: #EBF0F8;
  margin-bottom: 32rpx;
  overflow: hidden;
  border: 1rpx solid #E8ECF2;
  border-radius: 8rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
}

.progress-steps {
  display: flex;
  justify-content: space-between;
}

.step {
  text-align: center;
  flex: 1;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  background: #EBF0F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #B5C3D4;
  margin: 0 auto 8rpx;
  font-weight: bold;
  border: 1rpx solid #E8ECF2;
  border-radius: 8rpx;
}

.step.active .step-dot {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #ffffff;
  border-color: #5B8DEF;
}

.step-text {
  font-size: 26rpx;
  color: #B5C3D4;
}

.step.active .step-text {
  color: #2C3E5A;
  font-weight: bold;
}

.safety-section {
  background: #F8FAFE;
  padding: 24rpx;
  margin-bottom: 120rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
}

.safety-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.safety-text {
  font-size: 30rpx;
  color: #7A8BA0;
}

.footer-actions {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx;
  border-top: 1rpx solid #E8ECF2;
  display: flex;
  gap: 20rpx;
  z-index: 100;
}

.footer-actions .btn-secondary,
.footer-actions .btn-primary {
  flex: 1;
}

.btn-secondary {
  background: #ffffff;
  color: #2C3E5A;
  font-size: 34rpx;
  font-weight: bold;
  padding: 28rpx;
  text-align: center;
  border: 2rpx solid #5B8DEF;
  border-radius: 16rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  padding: 28rpx;
  text-align: center;
  border-radius: 16rpx;
}
