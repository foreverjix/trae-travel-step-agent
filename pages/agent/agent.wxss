.agent-header {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
}

.agent-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.agent-title-group {
  flex: 1;
}

.agent-name {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.agent-desc {
  font-size: 28rpx;
  display: block;
}

.input-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.input-item {
  margin-bottom: 28rpx;
}

.input-item:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 30rpx;
  color: #4A4E5A;
  margin-bottom: 16rpx;
  display: block;
  font-weight: bold;
}

.input-field {
  background: #FFF9F2;
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 34rpx;
  color: #2D3142;
  border: 2rpx solid #F3E5D8;
  box-sizing: border-box;
  width: 100%;
}

.preference-tags {
  display: flex;
  gap: 16rpx;
}

.preference-tag {
  flex: 1;
  padding: 22rpx 16rpx;
  background: #FFF9F2;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #6B7280;
  text-align: center;
  border: 2rpx solid #F3E5D8;
  font-weight: bold;
}

.preference-tag.active {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
  border-color: #FF8C42;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 66, 0.25);
}

.recommend-btn {
  margin-top: 32rpx;
  font-size: 34rpx;
  padding: 28rpx;
}

.plans-section {
  margin-bottom: 24rpx;
}

.plans-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.plan-card:active {
  opacity: 0.9;
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.plan-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3142;
}

.plan-badge {
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.plan-desc {
  font-size: 28rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.plan-segments {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.segment-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #FFF9F2;
  border-radius: 20rpx;
}

.segment-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.segment-info {
  flex: 1;
}

.segment-name {
  font-size: 30rpx;
  color: #2D3142;
  display: block;
  margin-bottom: 4rpx;
  font-weight: bold;
}

.segment-time {
  font-size: 24rpx;
  color: #6B7280;
}

.segment-price {
  font-size: 30rpx;
  color: #FF8C42;
  font-weight: bold;
}

.plan-summary {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background: #FFF9F2;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  text-align: center;
}

.summary-label {
  font-size: 26rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 6rpx;
}

.summary-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3142;
}

.summary-value.price {
  color: #FF8C42;
  font-size: 40rpx;
}

.plan-action {
  text-align: center;
  padding: 22rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 50rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 66, 0.25);
}
