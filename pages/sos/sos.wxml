<view class="sos-page">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <text class="nav-title">紧急求助</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view scroll-y class="sos-scroll" enhanced show-scrollbar="{{false}}">

    <!-- SOS 大按钮区 -->
    <view class="sos-hero">
      <view class="sos-btn-wrap">
        <view class="sos-pulse-ring"></view>
        <view class="sos-pulse-ring2"></view>
        <view class="sos-big-btn {{sosPressed ? 'pressed' : ''}}" bindlongpress="triggerSOS" bindtap="onSOSTap">
          <text class="sos-big-text">SOS</text>
          <text class="sos-big-hint">长按发送求助</text>
        </view>
      </view>
      <view class="sos-status {{sosStatus}}" wx:if="{{sosStatus}}">
        <text class="sos-status-text">{{sosStatusText}}</text>
      </view>
    </view>

    <!-- 紧急电话 -->
    <view class="section">
      <text class="section-label">紧急电话</text>
      <view class="quick-call-row">
        <view class="quick-call-item police" bindtap="callEmergency">
          <view class="quick-call-circle">
            <text class="quick-call-num">110</text>
          </view>
          <text class="quick-call-name">报警</text>
        </view>
        <view class="quick-call-item ambulance" bindtap="callAmbulance">
          <view class="quick-call-circle">
            <text class="quick-call-num">120</text>
          </view>
          <text class="quick-call-name">急救</text>
        </view>
      </view>
    </view>

    <!-- 紧急联系人 -->
    <view class="section">
      <view class="section-head">
        <text class="section-label">紧急联系人</text>
        <text class="section-more" bindtap="goToManage">管理</text>
      </view>
      <block wx:if="{{emergencyContacts.length > 0}}">
        <view class="contact-list">
          <view wx:for="{{emergencyContacts}}" wx:key="phone" class="contact-item">
            <view class="contact-avatar">{{item.nameFirstChar}}</view>
            <view class="contact-info">
              <text class="contact-name">{{item.name}}</text>
              <text class="contact-relation">{{item.relation || '紧急联系人'}}</text>
            </view>
            <view class="contact-actions">
              <view class="contact-btn call-btn" bindtap="callContact" data-phone="{{item.phone}}">
                <text>电话</text>
              </view>
              <view class="contact-btn sms-btn" bindtap="sendMessage" data-phone="{{item.phone}}">
                <text>短信</text>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="empty-contacts" bindtap="goToManage">
        <text class="empty-text">还没有紧急联系人</text>
        <text class="empty-add">+ 添加联系人</text>
      </view>
    </view>

    <!-- 当前位置 -->
    <view class="section">
      <view class="section-head">
        <text class="section-label">当前位置</text>
        <text class="section-more" bindtap="updateLocation">刷新</text>
      </view>
      <view class="location-card">
        <view class="location-pin">
          <text class="pin-icon">📍</text>
        </view>
        <text class="location-text">{{currentLocation || '正在获取位置...'}}</text>
      </view>
      <view class="share-btn" bindtap="shareLocation">
        <text class="share-text">分享位置给亲友</text>
      </view>
    </view>

    <!-- 快速求助 -->
    <view class="section">
      <text class="section-label">快速求助</text>
      <view class="quick-help-grid">
        <view class="quick-help-item" bindtap="helpFall">
          <view class="help-circle fall-circle">
            <text class="help-icon-text">摔</text>
          </view>
          <text class="help-label">摔倒</text>
        </view>
        <view class="quick-help-item" bindtap="helpLost">
          <view class="help-circle lost-circle">
            <text class="help-icon-text">迷</text>
          </view>
          <text class="help-label">迷路</text>
        </view>
        <view class="quick-help-item" bindtap="helpTraffic">
          <view class="help-circle traffic-circle">
            <text class="help-icon-text">事</text>
          </view>
          <text class="help-label">交通事故</text>
        </view>
        <view class="quick-help-item" bindtap="helpHealth">
          <view class="help-circle health-circle">
            <text class="help-icon-text">病</text>
          </view>
          <text class="help-label">突发疾病</text>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="tips-bar">
      <text class="tips-text">紧急情况请优先拨打110或120，并保持电话畅通</text>
    </view>

  </scroll-view>
</view>
