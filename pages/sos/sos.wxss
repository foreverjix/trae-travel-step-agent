.sos-page {
  min-height: 100vh;
  background: #F8FAFE;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 24rpx) 32rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E8ECF2;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 56rpx;
  color: #2C3E5A;
  line-height: 1;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.nav-placeholder {
  width: 64rpx;
}

/* 滚动区 */
.sos-scroll {
  height: calc(100vh - 112rpx - env(safe-area-inset-top));
}

/* ===== SOS 大按钮区 ===== */
.sos-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 40rpx;
}

.sos-btn-wrap {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sos-pulse-ring {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(229, 57, 53, 0.3);
  animation: sosPulse1 2s ease-out infinite;
}

.sos-pulse-ring2 {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(229, 57, 53, 0.2);
  animation: sosPulse2 2.5s ease-out infinite;
}

@keyframes sosPulse1 {
  0%   { transform: scale(1);   opacity: 0.8; }
  100% { transform: scale(1.3); opacity: 0; }
}

@keyframes sosPulse2 {
  0%   { transform: scale(1);   opacity: 0.5; }
  100% { transform: scale(1.5); opacity: 0; }
}

.sos-big-btn {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EF5350, #E53935);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(229, 57, 53, 0.4);
  z-index: 1;
  transition: transform 0.15s ease;
}

.sos-big-btn.pressed {
  transform: scale(0.93);
  box-shadow: 0 6rpx 20rpx rgba(229, 57, 53, 0.3);
}

.sos-big-text {
  font-size: 84rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 6rpx;
}

.sos-big-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.sos-status {
  margin-top: 36rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
}

.sos-status.sending {
  background: #FFF3E0;
}

.sos-status.responded {
  background: #E8F5E9;
}

.sos-status-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #2C3E5A;
}

/* ===== 通用 Section ===== */
.section {
  margin: 0 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 141, 239, 0.06);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E5A;
  margin-bottom: 24rpx;
  display: block;
}

.section-head .section-label {
  margin-bottom: 0;
}

.section-more {
  font-size: 30rpx;
  color: #5B8DEF;
  padding: 8rpx 16rpx;
  background: #EEF4FC;
  border-radius: 20rpx;
}

/* ===== 紧急电话 ===== */
.quick-call-row {
  display: flex;
  gap: 24rpx;
}

.quick-call-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 0;
  border-radius: 20rpx;
  transition: opacity 0.15s;
}

.quick-call-item:active {
  opacity: 0.8;
}

.quick-call-item.police {
  background: #FFEBEE;
}

.quick-call-item.ambulance {
  background: #E3F2FD;
}

.quick-call-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.police .quick-call-circle {
  background: linear-gradient(135deg, #EF5350, #E53935);
}

.ambulance .quick-call-circle {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
}

.quick-call-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.quick-call-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #2C3E5A;
}

/* ===== 紧急联系人 ===== */
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F8FAFE;
  border-radius: 20rpx;
  border: 1rpx solid #E8ECF2;
}

.contact-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.contact-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.contact-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C3E5A;
}

.contact-relation {
  font-size: 28rpx;
  color: #7A8BA0;
}

.contact-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.contact-btn {
  padding: 14rpx 28rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.call-btn {
  background: #5B8DEF;
  color: #FFFFFF;
}

.sms-btn {
  background: #FFFFFF;
  color: #5B8DEF;
  border: 2rpx solid #5B8DEF;
}

/* 空状态 */
.empty-contacts {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx;
  background: #F8FAFE;
  border-radius: 20rpx;
  border: 2rpx dashed #CDD5E0;
}

.empty-text {
  font-size: 30rpx;
  color: #7A8BA0;
}

.empty-add {
  font-size: 32rpx;
  color: #5B8DEF;
  font-weight: 500;
}

/* ===== 当前位置 ===== */
.location-card {
  display: flex;
  align-items: center;
  background: #F8FAFE;
  border-radius: 20rpx;
  border: 1rpx solid #E8ECF2;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.location-pin {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pin-icon {
  font-size: 40rpx;
}

.location-text {
  flex: 1;
  font-size: 32rpx;
  color: #2C3E5A;
  line-height: 1.5;
  word-break: break-all;
}

.share-btn {
  width: 100%;
  padding: 24rpx;
  background: #EEF4FC;
  border-radius: 16rpx;
  text-align: center;
  transition: opacity 0.15s;
}

.share-btn:active {
  opacity: 0.8;
}

.share-text {
  font-size: 32rpx;
  color: #5B8DEF;
  font-weight: 500;
}

/* ===== 快速求助 ===== */
.quick-help-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.quick-help-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  transition: opacity 0.15s;
}

.quick-help-item:active {
  opacity: 0.8;
}

.help-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fall-circle {
  background: #FFEBEE;
}

.lost-circle {
  background: #FFF3E0;
}

.traffic-circle {
  background: #F3E5F5;
}

.health-circle {
  background: #E8F5E9;
}

.help-icon-text {
  font-size: 40rpx;
  font-weight: 600;
}

.fall-circle .help-icon-text {
  color: #E53935;
}

.lost-circle .help-icon-text {
  color: #FB8C00;
}

.traffic-circle .help-icon-text {
  color: #8E24AA;
}

.health-circle .help-icon-text {
  color: #43A047;
}

.help-label {
  font-size: 28rpx;
  color: #2C3E5A;
  font-weight: 500;
}

/* ===== 底部提示 ===== */
.tips-bar {
  margin: 8rpx 32rpx 48rpx;
  padding: 24rpx 28rpx;
  background: #FFF8E1;
  border-radius: 16rpx;
  border: 1rpx solid #FFE082;
}

.tips-text {
  font-size: 28rpx;
  color: #7A8BA0;
  line-height: 1.6;
}
