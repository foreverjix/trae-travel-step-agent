.sos-header {
  text-align: center;
  padding: 30rpx 0 40rpx;
}

.sos-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #EF476F;
  display: block;
  margin-bottom: 12rpx;
}

.sos-subtitle {
  font-size: 30rpx;
  color: #6B7280;
  display: block;
}

.emergency-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.emergency-btn {
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.emergency-btn:active {
  opacity: 0.9;
}

.emergency-btn.police {
  background: linear-gradient(135deg, #EF476F 0%, #FF6B85 100%);
}

.emergency-btn.ambulance {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
}

.emergency-icon-ring {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.emergency-icon {
  font-size: 52rpx;
}

.emergency-info {
  display: flex;
  flex-direction: column;
}

.emergency-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 6rpx;
}

.emergency-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
}

.contact-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFF9F2;
  border-radius: 20rpx;
}

.contact-avatar {
  width: 84rpx;
  height: 84rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
  margin-right: 20rpx;
}

.contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contact-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3142;
  margin-bottom: 6rpx;
}

.contact-relation {
  font-size: 26rpx;
  color: #6B7280;
}

.contact-actions {
  display: flex;
  gap: 12rpx;
}

.contact-actions .action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.action-btn.call {
  background: #E6FAF4;
}

.action-btn.message {
  background: #E6F4FF;
}

.empty-mini {
  text-align: center;
  padding: 40rpx;
  background: #FFF9F2;
  border-radius: 20rpx;
}

.empty-mini-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 8rpx;
}

.empty-mini-text {
  font-size: 30rpx;
  color: #FF8C42;
  font-weight: bold;
}

.location-box {
  display: flex;
  align-items: center;
  background: #FFF9F2;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.location-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.location-text {
  font-size: 30rpx;
  color: #2D3142;
  flex: 1;
  line-height: 1.5;
}

.location-btn {
  width: 100%;
}

.help-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.help-item {
  background: #FFF9F2;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.help-item:active {
  opacity: 0.85;
}

.help-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.help-icon.fall-bg {
  background: #FFEBEF;
}

.help-icon.lost-bg {
  background: #E6F4FF;
}

.help-icon.traffic-bg {
  background: #FFF4E0;
}

.help-icon.health-bg {
  background: #FFE4EC;
}

.help-text {
  font-size: 30rpx;
  color: #2D3142;
  font-weight: bold;
}

.tips-card {
  background: #FFF9F2;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #FFE4D1;
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.tips-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3142;
}

.tips-list {
  display: flex;
  flex-direction: column;
}

.tips-item {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
}
