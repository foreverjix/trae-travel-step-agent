/* 视觉导航页面 - 大字、大按钮、简洁无装饰 */

page {
  background: #f5f5f5;
}

.vg-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 420rpx;
}

/* ------- 行程小卡片 ------- */
.vg-trip-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.vg-trip-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.vg-trip-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.vg-trip-city {
  font-size: 34rpx;
  color: #1a1a1a;
}
.vg-trip-arrow {
  margin: 0 16rpx;
  font-size: 32rpx;
  color: #888;
}
.vg-trip-meta {
  font-size: 28rpx;
  color: #555;
}

.vg-trip-none {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.vg-trip-none-text {
  display: block;
  font-size: 32rpx;
  color: #555;
  margin-bottom: 8rpx;
}
.vg-trip-none-sub {
  font-size: 26rpx;
  color: #999;
}

/* ------- 拍照预览 ------- */
.vg-photo-box {
  width: 100%;
  background: #000;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.vg-photo {
  width: 100%;
  height: 560rpx;
  display: block;
}

.vg-photo-empty {
  background: #ffffff;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.vg-photo-empty-icon {
  display: block;
  font-size: 96rpx;
  margin-bottom: 16rpx;
}
.vg-photo-empty-text {
  display: block;
  font-size: 34rpx;
  color: #333;
  margin-bottom: 8rpx;
}
.vg-photo-empty-sub {
  font-size: 26rpx;
  color: #999;
}

/* ------- 底部大按钮固定 ------- */
.vg-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f5f5f5 70%, rgba(245, 245, 245, 0));
}

.vg-btn {
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}
.vg-btn-disabled {
  opacity: 0.6;
}
.vg-btn-primary {
  background: #FF8C42;
}

/* 主按钮：巨无霸 */
.vg-btn-main {
  width: 100%;
  height: 180rpx;
  padding: 0 32rpx;
}
.vg-btn-main-inner {
  display: flex;
  align-items: center;
  width: 100%;
}
.vg-btn-main-icon {
  font-size: 80rpx;
  margin-right: 24rpx;
}
.vg-btn-main-texts {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.vg-btn-main-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}
.vg-btn-main-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.vg-tip-row {
  margin-top: 16rpx;
  text-align: center;
}
.vg-tip {
  font-size: 26rpx;
  color: #888;
}

/* ------- 大字回答弹窗 ------- */
.vg-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 24rpx;
}

.vg-answer-card {
  width: 100%;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 32rpx;
  max-height: 85vh;
  overflow-y: auto;
}

.vg-answer-header {
  border-bottom: 2rpx solid #eee;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}
.vg-answer-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.vg-retry-row {
  margin-bottom: 32rpx;
}
.vg-retry-text {
  font-size: 38rpx;
  color: #333;
  line-height: 1.6;
}

/* 4 段内容 - 每段都是大字 */
.vg-sections {
  margin-bottom: 32rpx;
}
.vg-section {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.vg-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}
.vg-section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8C42;
  margin-bottom: 12rpx;
}
.vg-section-content {
  display: block;
  font-size: 40rpx;
  color: #1a1a1a;
  line-height: 1.6;
  white-space: pre-wrap;
}

.vg-answer-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.vg-btn-sound {
  flex: 1;
  background: #f0f0f0;
  height: 110rpx;
}
.vg-btn-sound-icon {
  font-size: 40rpx;
  margin-right: 8rpx;
}
.vg-btn-sound-text {
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.vg-btn-ok {
  flex: 1.5;
  height: 110rpx;
}
.vg-btn-ok-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.vg-fallback-row {
  margin-top: 24rpx;
}
.vg-fallback-row .vg-btn-sound {
  background: #E3F2FD;
}

/* ------- 错误提示 ------- */
.vg-toast {
  position: fixed;
  left: 50%;
  top: 40%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.75);
  color: #ffffff;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
  z-index: 9999;
  max-width: 80%;
}
.vg-toast-text {
  font-size: 32rpx;
  line-height: 1.5;
}
