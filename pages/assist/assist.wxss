.assist-header {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
}

.assist-icon-box {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-right: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.assist-title-group {
  flex: 1;
}

.assist-main-title {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.assist-desc {
  font-size: 28rpx;
  display: block;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.function-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.function-card:active {
  opacity: 0.85;
}

.function-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 0 auto 16rpx;
}

.function-icon.bind-bg {
  background: #FFF2E6;
}

.function-icon.manage-bg {
  background: #E6FAF4;
}

.function-icon.location-bg {
  background: #E6F4FF;
}

.function-icon.help-bg {
  background: #FFEBEF;
}

.function-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 6rpx;
}

.function-desc {
  font-size: 26rpx;
  color: #6B7280;
}

.family-section {
  margin-bottom: 24rpx;
}

.family-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.family-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFF9F2;
  border-radius: 20rpx;
}

.family-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
  margin-right: 20rpx;
}

.family-info {
  flex: 1;
}

.family-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 4rpx;
}

.family-relation {
  font-size: 26rpx;
  color: #6B7280;
}

.btn-mini {
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.call-btn {
  background: #E6FAF4;
  color: #06D6A0;
}

.guide-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.guide-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.guide-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.guide-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3142;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
}

.guide-num {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-weight: bold;
}

.guide-text {
  font-size: 30rpx;
  color: #4A4E5A;
  line-height: 1.5;
  padding-top: 4rpx;
}
