<view class="container">
  <view class="header-gradient">
    <view class="header-back" bindtap="goBack">
      <text>‹</text>
    </view>
    <view class="monitor-header">
      <view class="monitor-status">
        <view class="status-dot {{isMonitoring ? 'active' : ''}}"></view>
        <text class="status-text">{{isMonitoring ? '监护中' : '未开启监护'}}</text>
      </view>
      <view class="monitor-title-group">
        <text class="monitor-main-title text-white">智能监护中心</text>
        <text class="monitor-desc text-white" style="opacity: 0.9;">出行安全，实时守护</text>
      </view>
    </view>
  </view>

  <view class="current-trip-card" wx:if="{{currentTrip}}">
    <view class="trip-card-header">
      <text class="trip-card-title">当前行程</text>
      <text class="trip-card-status">{{currentTrip.statusText}}</text>
    </view>
    <view class="trip-card-body">
      <view class="trip-route">
        <text class="route-from">{{currentTrip.from}}</text>
        <text class="route-arrow">→</text>
        <text class="route-to">{{currentTrip.to}}</text>
      </view>
      <view class="trip-info-row">
        <text class="trip-info-item">车次：{{currentTrip.name}}</text>
        <text class="trip-info-item">出发：{{currentTrip.departureTime}}</text>
      </view>
      <view class="trip-location">
        <text class="location-label">当前位置：</text>
        <text class="location-value">{{currentLocation || '定位中...'}}</text>
      </view>
    </view>
  </view>

  <view class="no-trip-card" wx:else>
    <text class="no-trip-icon-text">暂无行程</text>
    <text class="no-trip-text">当前没有进行中的行程</text>
    <text class="no-trip-desc">开始出行后，这里会实时显示位置和状态</text>
  </view>

  <view class="anomaly-section">
    <view class="section-header">
      <text class="card-title">异常提醒</text>
      <text class="section-more" wx:if="{{unreadCount > 0}}" bindtap="markAllRead">{{unreadCount}}条未读</text>
      <text class="section-more" wx:else>全部已读</text>
    </view>

    <view class="anomaly-list" wx:if="{{anomalyEvents && anomalyEvents.length > 0}}">
      <view class="anomaly-item {{!item.read ? 'unread' : ''}}" wx:for="{{anomalyEvents}}" wx:key="id" bindtap="viewEvent" data-event="{{item}}">
        <view class="anomaly-icon-box {{item.type}}">
          <text class="anomaly-label">提醒</text>
        </view>
        <view class="anomaly-content">
          <view class="anomaly-title-row">
            <text class="anomaly-title">{{item.title}}</text>
            <text class="anomaly-time">{{item.time}}</text>
          </view>
          <text class="anomaly-desc">{{item.desc}}</text>
          <text class="anomaly-location">位置：{{item.location}}</text>
        </view>
        <view class="anomaly-dot" wx:if="{{!item.read}}"></view>
      </view>
    </view>

    <view class="empty-anomaly" wx:else>
      <text class="empty-icon-text">一切正常</text>
      <text class="empty-text">暂无异常记录</text>
      <text class="empty-desc">放心出行</text>
    </view>
  </view>

  <view class="function-grid">
    <view class="function-card" bindtap="goToBind">
      <view class="function-icon bind-bg">绑定</view>
      <text class="function-title">绑定亲友</text>
      <text class="function-desc">远程协助监护</text>
    </view>

    <view class="function-card" bindtap="goToManage">
      <view class="function-icon manage-bg">亲友</view>
      <text class="function-title">亲友列表</text>
      <text class="function-desc">管理已绑账号</text>
    </view>

    <view class="function-card" bindtap="refreshLocation">
      <view class="function-icon location-bg">定位</view>
      <text class="function-title">刷新位置</text>
      <text class="function-desc">查看实时位置</text>
    </view>

    <view class="function-card" bindtap="callForHelp">
      <view class="function-icon help-bg">紧急</view>
      <text class="function-title">紧急联系</text>
      <text class="function-desc">一键呼叫亲友</text>
    </view>
  </view>
</view>