<view class="container">
  <view class="header-gradient">
    <view class="assist-header">
      <view class="assist-icon-box">👨‍👩‍👧</view>
      <view class="assist-title-group">
        <text class="assist-main-title text-white">亲友协助社区</text>
        <text class="assist-desc text-white" style="opacity: 0.9;">让子女帮助父母更便捷地出行</text>
      </view>
    </view>
  </view>

  <view class="function-grid">
    <view class="function-card" bindtap="goToBind">
      <view class="function-icon bind-bg">➕</view>
      <text class="function-title">绑定子女</text>
      <text class="function-desc">远程协助预订</text>
    </view>

    <view class="function-card" bindtap="goToManage">
      <view class="function-icon manage-bg">👥</view>
      <text class="function-title">协助列表</text>
      <text class="function-desc">管理已绑亲友</text>
    </view>

    <view class="function-card" bindtap="shareLocation">
      <view class="function-icon location-bg">📍</view>
      <text class="function-title">分享位置</text>
      <text class="function-desc">实时共享行程</text>
    </view>

    <view class="function-card" bindtap="requestHelp">
      <view class="function-icon help-bg">🆘</view>
      <text class="function-title">请求协助</text>
      <text class="function-desc">一键呼叫子女</text>
    </view>
  </view>

  <view class="family-section card" wx:if="{{assistAccounts.length > 0}}">
    <view class="section-header">
      <text class="card-title">已绑定的亲友</text>
      <text class="section-more" bindtap="goToManage">管理 ›</text>
    </view>
    <view class="family-list">
      <view class="family-item" wx:for="{{assistAccounts}}" wx:key="phone">
        <view class="family-avatar">{{item.nameFirstChar}}</view>
        <view class="family-info">
          <text class="family-name">{{item.name}}</text>
          <text class="family-relation">{{item.relation}}</text>
        </view>
        <view class="btn-mini call-btn" bindtap="callFamily" data-phone="{{item.phone}}">📞 通话</view>
      </view>
    </view>
  </view>

  <view class="guide-card">
    <view class="guide-header">
      <text class="guide-icon">💡</text>
      <text class="guide-title">使用指南</text>
    </view>
    <view class="guide-list">
      <view class="guide-item">
        <view class="guide-num">1</view>
        <text class="guide-text">绑定子女手机号，子女可远程协助</text>
      </view>
      <view class="guide-item">
        <view class="guide-num">2</view>
        <text class="guide-text">出行时分享位置，家人可实时查看</text>
      </view>
      <view class="guide-item">
        <view class="guide-num">3</view>
        <text class="guide-text">遇到问题时，一键呼叫子女协助</text>
      </view>
    </view>
  </view>
</view>
