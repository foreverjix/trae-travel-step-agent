.header-gradient {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 44rpx) 32rpx 48rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.header-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 14rpx;
  flex-shrink: 0;
}

.header-back text {
  font-size: 44rpx;
  color: #ffffff;
  font-weight: bold;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stats-card {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-value {
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 26rpx;
  color: #ffffff;
  opacity: 0.9;
  font-weight: bold;
}

.stats-divider {
  width: 1rpx;
  background: #ffffff;
  opacity: 0.3;
}

.medals-section {
  margin-bottom: 24rpx;
}

.medals-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.medal-item {
  width: 48%;
  background: #F8FAFE;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
  border: 1rpx solid #E8ECF2;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.medal-item:active {
  opacity: 0.85;
}

.medal-unlocked {
  background: #ffffff;
  border-color: #5B8DEF;
}

.medal-locked {
  opacity: 0.6;
}

.medal-icon-box {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 20rpx;
  background: #EBF0F8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.medal-unlocked .medal-icon-box {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
}

.medal-lock {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 36rpx;
  height: 36rpx;
  background: #E8ECF2;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.medal-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 8rpx;
}

.medal-desc {
  font-size: 24rpx;
  color: #7A8BA0;
  display: block;
  line-height: 1.4;
}

.medal-condition {
  font-size: 22rpx;
  color: #2C3E5A;
  margin-top: 10rpx;
  display: block;
  font-weight: bold;
}

.tips-card {
  background: #F8FAFE;
  border-radius: 20rpx;
  padding: 32rpx;
  border: 1rpx solid #E8ECF2;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2C3E5A;
}

.tips-list {
  display: flex;
  flex-direction: column;
}

.tips-item {
  font-size: 28rpx;
  color: #7A8BA0;
  line-height: 1.8;
}
