.stats-card {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 28rpx;
  padding: 40rpx 24rpx;
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.25);
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-value {
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: bold;
}

.stats-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
}

.medals-section {
  margin-bottom: 24rpx;
}

.medals-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.medal-item {
  width: 48%;
  background: #FFF9F2;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.medal-item:active {
  opacity: 0.85;
}

.medal-unlocked {
  background: #ffffff;
  border-color: #FFE4D1;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.1);
}

.medal-locked {
  opacity: 0.6;
}

.medal-icon-box {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 20rpx;
  background: #FFF2E6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.medal-unlocked .medal-icon-box {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 66, 0.25);
}

.medal-emoji {
  font-size: 56rpx;
}

.medal-unlocked .medal-emoji {
  filter: brightness(1.1);
}

.medal-lock {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 36rpx;
  height: 36rpx;
  background: #E5E7EB;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.medal-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 8rpx;
}

.medal-desc {
  font-size: 24rpx;
  color: #6B7280;
  display: block;
  line-height: 1.4;
}

.medal-condition {
  font-size: 22rpx;
  color: #FF8C42;
  margin-top: 10rpx;
  display: block;
  font-weight: bold;
}

.tips-card {
  background: #FFF9F2;
  border-radius: 28rpx;
  padding: 32rpx;
  border: 2rpx solid #FFE4D1;
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.tips-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3142;
}

.tips-list {
  display: flex;
  flex-direction: column;
}

.tips-item {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
}
