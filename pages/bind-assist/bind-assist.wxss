.header-gradient {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 56rpx) 32rpx 48rpx;
}

.bind-section {
  padding-bottom: 32rpx;
}

.empty-state {
  background: #ffffff;
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.empty-icon-text {
  font-size: 36rpx;
  color: #7A8BA0;
  display: block;
  margin-bottom: 24rpx;
  font-weight: bold;
}

.empty-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 34rpx;
  color: #7A8BA0;
  display: block;
  margin-bottom: 32rpx;
}

.empty-state .btn-primary {
  width: 100%;
}

.parent-list {
  margin-bottom: 32rpx;
}

.list-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.parent-card {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.parent-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.parent-avatar {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.avatar-text {
  font-size: 46rpx;
  color: #ffffff;
  font-weight: bold;
}

.parent-detail {
  flex: 1;
}

.parent-name {
  font-size: 42rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 6rpx;
}

.parent-relation {
  font-size: 28rpx;
  color: #7A8BA0;
  display: block;
}

.parent-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  background: #F8FAFE;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 12rpx;
}

.action-btn:active {
  background: #EBF0F8;
}

.action-text {
  font-size: 28rpx;
  color: #2C3E5A;
  font-weight: bold;
}

.parent-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8ECF2;
}

.bind-time {
  font-size: 26rpx;
  color: #7A8BA0;
}

.delete-btn {
  font-size: 26rpx;
  color: #2C3E5A;
  padding: 8rpx 16rpx;
}

.add-parent {
  background: #ffffff;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 1rpx dashed #5B8DEF;
  border-radius: 12rpx;
}

.add-parent:active {
  background: #EBF0F8;
}

.add-icon {
  font-size: 48rpx;
  color: #5B8DEF;
  font-weight: bold;
}

.add-text {
  font-size: 32rpx;
  color: #5B8DEF;
  font-weight: bold;
}

.tips-section {
  padding-bottom: 32rpx;
}

.tips-card {
  background: #F8FAFE;
  padding: 28rpx;
  display: flex;
  gap: 20rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.tips-label {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  height: fit-content;
  border-radius: 8rpx;
}

.tips-content {
  flex: 1;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 8rpx;
}

.tips-desc {
  font-size: 28rpx;
  color: #7A8BA0;
  display: block;
  line-height: 1.6;
}
