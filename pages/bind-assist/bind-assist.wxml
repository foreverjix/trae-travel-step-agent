<view class="container">
  <view class="header-gradient">
    <text class="page-title text-white">{{mode === 'child' ? '绑定父母账号' : '绑定子女辅助账号'}}</text>
    <text class="page-subtitle text-white" style="opacity: 0.9;">{{mode === 'child' ? '绑定后可以帮父母规划出行' : '让子女帮助您管理出行事务'}}</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="form-label">{{mode === 'child' ? '父母姓名' : '子女姓名'}}</text>
      <input 
        class="form-input" 
        placeholder="{{mode === 'child' ? '请输入父母姓名' : '请输入子女姓名'}}" 
        value="{{formData.name}}"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">{{mode === 'child' ? '父母手机号' : '子女手机号'}}</text>
      <input 
        class="form-input" 
        placeholder="{{mode === 'child' ? '请输入父母手机号' : '请输入子女手机号'}}" 
        type="number"
        value="{{formData.phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">关系</text>
      <picker 
        mode="selector" 
        range="{{relations}}" 
        value="{{relationIndex}}"
        bindchange="onRelationChange"
      >
        <view class="form-select">
          {{relations[relationIndex] || '请选择关系'}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">验证码</text>
      <view class="code-input-wrap">
        <input 
          class="form-input code-input" 
          placeholder="请输入验证码" 
          type="number"
          value="{{formData.code}}"
          bindinput="onCodeInput"
        />
        <view 
          class="send-code-btn {{canSendCode ? '' : 'disabled'}}" 
          bindtap="sendCode"
        >
          {{canSendCode ? '发送验证码' : countdown + '秒后重发'}}
        </view>
      </view>
    </view>

    <view class="btn-primary mt-40" bindtap="bindAccount">确认绑定</view>
  </view>

  <view class="tips-card">
    <view class="tips-header">
      <text class="tips-icon">💡</text>
      <text class="tips-title">绑定说明</text>
    </view>
    <view class="tips-list">
      <text class="tips-item" wx:if="{{mode === 'child'}}">• 绑定后可以帮父母规划行程、预订车票</text>
      <text class="tips-item" wx:if="{{mode === 'child'}}">• 可以查看父母的出行记录和状态</text>
      <text class="tips-item" wx:if="{{mode === 'child'}}">• 支持绑定多个父母账号</text>
      <text class="tips-item" wx:if="{{mode !== 'child'}}">• 绑定后子女可以远程帮您预订车票、叫车</text>
      <text class="tips-item" wx:if="{{mode !== 'child'}}">• 子女可以接收您的出行状态通知</text>
      <text class="tips-item" wx:if="{{mode !== 'child'}}">• 紧急情况下子女可以快速定位您的位置</text>
      <text class="tips-item" wx:if="{{mode !== 'child'}}">• 支持绑定多个子女账号</text>
    </view>
  </view>
</view>
