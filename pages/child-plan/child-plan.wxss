.page {
  min-height: 100vh;
  background: #F5F8FC;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ===== 头部 ===== */
.header {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 56rpx) 32rpx 48rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

/* ===== 主体 ===== */
.body {
  padding: 24rpx 32rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  padding: 24rpx 0;
}

.form-item:first-child {
  padding-top: 0;
}

.form-item:last-child {
  padding-bottom: 0;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
}

.status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  background: #E8F5E9;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #4CAF50;
}

.status.loading {
  background: #EEF4FC;
  color: #5B8DEF;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  background: #4CAF50;
  border-radius: 50%;
}

.status.loading .status-dot {
  background: #5B8DEF;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* 输入框外层容器 */
.input-box {
  background: #FAFAFA;
  border-radius: 10rpx;
  border: 1rpx solid #F0F0F0;
  padding: 18rpx 24rpx;
}

/* textarea 替代 input，避免原生 input 高度裁剪问题 */
.ta {
  width: 100% !important;
  font-size: 32rpx !important;
  color: #333 !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  box-sizing: border-box;
}

.ph {
  color: #999;
  font-size: 32rpx;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-text {
  font-size: 32rpx;
  color: #333;
}

.date-text.ph {
  color: #999;
}

.arrow {
  font-size: 40rpx;
  color: #5B8DEF;
  font-weight: 300;
  flex-shrink: 0;
}

/* ===== 主按钮 ===== */
.main-btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(91, 141, 239, 0.3);
}

.main-btn text {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

/* ===== 方案列表 ===== */
.plans {
  margin-top: 40rpx;
}

.plans-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.plans-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.plans-count {
  font-size: 24rpx;
  color: #999;
}

.plan {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 14rpx;
  border: 2rpx solid #F0F0F0;
  display: flex;
  gap: 16rpx;
}

.plan.active {
  border-color: #5B8DEF;
  background: #EEF4FC;
}

.plan-left {
  padding-top: 4rpx;
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #DDD;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio.checked {
  border-color: #5B8DEF;
}

.radio-dot {
  width: 18rpx;
  height: 18rpx;
  background: #5B8DEF;
  border-radius: 50%;
}

.plan-right {
  flex: 1;
  min-width: 0;
}

.plan-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.tag {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.duration {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.price {
  display: flex;
  align-items: baseline;
  color: #5B8DEF;
  margin-left: auto;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: 600;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
}

.price-unit {
  font-size: 22rpx;
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  position: relative;
}

.step-line {
  position: absolute;
  left: 8rpx;
  top: -14rpx;
  width: 3rpx;
  height: 14rpx;
  background: #E0ECF7;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  background: #5B8DEF;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  line-height: 1.4;
}

/* ===== 确认按钮 ===== */
.confirm-btn {
  background: linear-gradient(135deg, #66BB6A, #43A047);
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(67, 160, 71, 0.3);
  margin: 32rpx 0;
}

.confirm-btn text {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* ===== 空状态 ===== */
.empty {
  padding: 48rpx 40rpx;
  margin-top: 32rpx;
  background: #fff;
  border-radius: 14rpx;
  border: 2rpx dashed #E0ECF7;
}

.empty-text {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* ===== 弹窗 ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-box {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 32rpx;
  width: 100%;
  max-width: 540rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  line-height: 1.6;
  margin-bottom: 40rpx;
  white-space: pre-line;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  border-radius: 28rpx;
  padding: 24rpx;
  text-align: center;
}

.modal-btn text {
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn.secondary {
  background: #F5F5F5;
}

.modal-btn.secondary text {
  color: #666;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
}

.modal-btn.primary text {
  color: #fff;
}
