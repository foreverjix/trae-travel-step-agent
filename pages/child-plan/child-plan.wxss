.input-section {
  margin-bottom: 32rpx;
}

.input-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.input-label {
  font-size: 28rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 12rpx;
}

.input-field {
  font-size: 32rpx;
  color: #2D3142;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 40rpx;
  color: #9A5B2E;
}

.plan-btn {
  width: 100%;
  display: block;
}

/* 方案列表 */
.plans-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.plan-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.plan-card.selected {
  border-color: #FF8C42;
  background: #FFF9F2;
}

.plan-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.plan-badge {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: bold;
}

.plan-duration {
  font-size: 32rpx;
  color: #2D3142;
  font-weight: bold;
  flex: 1;
}

.plan-price {
  font-size: 36rpx;
  color: #FF8C42;
  font-weight: bold;
}

.plan-steps {
  position: relative;
  padding-left: 24rpx;
}

.step-item {
  position: relative;
  padding-bottom: 20rpx;
}

.step-dot {
  position: absolute;
  left: -24rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF8C42;
}

.step-content {
  padding-left: 16rpx;
}

.step-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.step-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2D3142;
}

.step-provider {
  font-size: 22rpx;
  color: #FF8C42;
  background: rgba(255, 140, 66, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #6B7280;
}

.step-line {
  position: absolute;
  left: -18rpx;
  top: 32rpx;
  bottom: 0;
  width: 4rpx;
  background: #F3F4F6;
}

.plan-select {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #FFE9D6;
}

.select-icon {
  font-size: 28rpx;
  color: #06D6A0;
  font-weight: bold;
}

.select-text {
  font-size: 28rpx;
  color: #06D6A0;
  font-weight: bold;
}

.send-btn {
  width: 100%;
  display: block;
}

/* 弹窗 */
.confirm-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 56rpx 48rpx;
  width: 80%;
  max-width: 600rpx;
  text-align: center;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.2);
}

.modal-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #6B7280;
  display: block;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  border-radius: 24rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.modal-btn.cancel {
  background: #F3F4F6;
  color: #6B7280;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
}