<view class="container">
  <view class="header-gradient">
    <view class="header-back" bindtap="goBack">
      <text>‹</text>
    </view>
    <view class="user-card" wx:if="{{userInfo}}">
      <view class="user-avatar">
        <text class="avatar-icon">用户</text>
      </view>
      <view class="user-info">
        <text class="user-name text-white">{{userInfo.name}}</text>
        <text class="user-phone text-white" style="opacity: 0.9;">{{userInfo.phone}}</text>
      </view>
      <view class="edit-btn" bindtap="editProfile">
        <text>编辑</text>
      </view>
    </view>

    <view class="login-card-simple" wx:else>
      <text class="login-icon">登录</text>
      <text class="login-text text-white">请先登录</text>
      <view class="btn-white" bindtap="goToLogin">立即登录</view>
    </view>
  </view>

  <view class="stats-card" wx:if="{{userInfo}}">
    <view class="stat-item" bindtap="goToOrders">
      <text class="stat-value">{{orderCount}}</text>
      <text class="stat-label">全部订单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goToAssist">
      <text class="stat-value">{{assistCount}}</text>
      <text class="stat-label">协助亲友</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-card">
      <text class="menu-title">常用服务</text>
      <view class="menu-item" bindtap="goToPassenger">
        <text class="menu-text">乘车人信息</text>
        <text class="menu-tag green">购票用</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAddress">
        <text class="menu-text">常用地址</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToOrders">
        <text class="menu-text">我的订单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAssist">
        <text class="menu-text">亲友协助</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-card">
      <text class="menu-title">安全与帮助</text>
      <view class="menu-item" bindtap="goToSos">
        <text class="menu-text">紧急求助</text>
        <text class="menu-tag">重要</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item">
        <text class="menu-text">客服中心</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item">
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="logout-section" wx:if="{{userInfo}}">
    <view class="btn-secondary logout-btn" bindtap="logout">退出登录</view>
  </view>

  <view class="version-info">
    <text class="version-text">乐龄出行 v1.0.0</text>
    <text class="copyright">专为中老年朋友打造的出行服务平台</text>
  </view>

  <custom-tabbar current-path="/pages/profile/profile"></custom-tabbar>
  <ai-assistant aiEnabled="{{aiAssistantEnabled}}"></ai-assistant>
</view>
