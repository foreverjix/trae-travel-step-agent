/* 个人中心样式 - 温暖友好版 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFE 0%, #F5F8FC 30%, #F8FAFE 100%);
  padding-bottom: 60rpx;
}

.header-gradient {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 56rpx) 32rpx 48rpx;
  position: relative;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10px);
}

.avatar-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.user-phone {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.edit-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.login-card-simple {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.login-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.login-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 36rpx;
}

.btn-white {
  background: #FFFFFF;
  color: #5B8DEF;
  border-radius: 32rpx;
  padding: 24rpx 64rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.stats-card {
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(91, 141, 239, 0.1);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-around;
  margin: -24rpx 32rpx 32rpx;
  position: relative;
  z-index: 10;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #5B8DEF;
  display: block;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #7A8BA0;
  font-weight: 500;
}

.stat-divider {
  width: 2rpx;
  background: #E8ECF2;
  margin: 0 20rpx;
}

.menu-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 32rpx;
}

.menu-card {
  background: #FFFFFF;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
}

.menu-title {
  font-size: 26rpx;
  color: #B5C3D4;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  padding: 16rpx 12rpx 8rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 12rpx;
  border-bottom: 1rpx solid #F5F0EB;
  transition: background 0.2s;
  border-radius: 12rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F2F6FC;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #2C3E5A;
  font-weight: 500;
}

.menu-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  font-weight: 600;
}

.menu-tag.blue {
  background: linear-gradient(135deg, #42A5F5, #1E88E5);
}

.menu-tag.green {
  background: linear-gradient(135deg, #66BB6A, #43A047);
}

.menu-arrow {
  font-size: 36rpx;
  color: #CDD5E0;
  font-weight: 300;
}

.logout-section {
  margin-top: 40rpx;
  margin-bottom: 48rpx;
  padding: 0 32rpx;
}

.logout-btn {
  width: 100%;
  background: #FFFFFF;
  color: #E53935;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.version-info {
  text-align: center;
  padding: 32rpx 20rpx;
}

.version-text {
  font-size: 26rpx;
  color: #B5C3D4;
  display: block;
  margin-bottom: 10rpx;
}

.copyright {
  font-size: 24rpx;
  color: #CDD5E0;
}
