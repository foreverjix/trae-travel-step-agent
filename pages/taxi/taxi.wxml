<!-- 打车服务 - 沉浸式大卡片UI -->
<view class="page">
  <!-- 顶部安心栏 -->
  <view class="top-bar">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="reassure">
      <text class="reassure-text">点错了也没关系，可随时取消</text>
    </view>
  </view>

  <!-- 温馨提示条 -->
  <view class="guide-bar">
    <text class="guide-text">📌 不会操作？点右下角蓝色AI按钮，说话就行</text>
  </view>

  <!-- 出发/目的卡片 -->
  <view class="route-card">
    <!-- 出发地 -->
    <view class="route-row {{highlightFields['出发地'] ? 'ai-highlight' : ''}}" wx:if="{{role === 'elder'}}">
      <view class="route-dot from-dot"></view>
      <view class="route-main">
        <text class="route-label">当前位置</text>
        <block wx:if="{{from}}">
          <text class="route-value">{{from}}</text>
        </block>
        <block wx:else>
          <text class="route-value placeholder">正在定位…</text>
        </block>
      </view>
      <view class="loc-btn" bindtap="useCurrentLocation">
        <text class="loc-text">刷新</text>
      </view>
    </view>

    <!-- 子女端出发地 -->
    <view class="route-row {{highlightFields['出发地'] ? 'ai-highlight' : ''}}" wx:else>
      <view class="route-dot from-dot"></view>
      <view class="route-main">
        <text class="route-label">父母位置</text>
        <text class="route-value {{from ? '' : 'placeholder'}}">{{from || '点右侧获取父母位置'}}</text>
      </view>
      <view class="loc-btn" bindtap="useCurrentLocation">
        <text class="loc-text">获取位置</text>
      </view>
    </view>

    <view class="route-line"></view>

    <!-- 目的地 -->
    <view class="route-row {{highlightFields['目的地'] ? 'ai-highlight' : ''}}">
      <view class="route-dot to-dot"></view>
      <view class="route-main">
        <text class="route-label">目的地</text>
        <input class="route-input" placeholder="要去哪里？" placeholder-class="ph-style" value="{{to}}" bindinput="onToInput" />
      </view>
    </view>
  </view>

  <!-- 预估卡片 -->
  <view class="estimate-card" wx:if="{{distance > 0}}">
    <view class="est-main">
      <view class="est-item">
        <text class="est-num">{{distance}}</text>
        <text class="est-unit">公里</text>
      </view>
      <view class="est-divider"></view>
      <view class="est-item">
        <text class="est-num">{{duration}}</text>
        <text class="est-unit">到达</text>
      </view>
      <view class="est-divider"></view>
      <view class="est-item price-item">
        <text class="est-price-sym">¥</text>
        <text class="est-price-num">{{price}}</text>
        <text class="est-unit">预估</text>
      </view>
    </view>
    <text class="est-hint">价格仅供参考，实际多退少补</text>
  </view>

  <!-- 叫车按钮 -->
  <view class="call-btn {{!from || !to ? 'disabled' : ''}}" bindtap="callTaxi">
    <text class="call-text">叫车</text>
    <text class="call-sub" wx:if="{{price > 0}}">预估¥{{price}} · 可随时取消</text>
    <text class="call-sub" wx:else>请先填写地址</text>
  </view>

  <!-- 快捷建议 -->
  <view class="quick-section" wx:if="{{!from || !to}}">
    <text class="quick-title">常用目的地</text>
    <view class="quick-grid">
      <view class="quick-item" bindtap="setQuickTo" data-to="省人民医院">
        <text class="quick-emoji">🏥</text>
        <text class="quick-label">去医院</text>
      </view>
      <view class="quick-item" bindtap="setQuickTo" data-to="家">
        <text class="quick-emoji">🏠</text>
        <text class="quick-label">回家</text>
      </view>
      <view class="quick-item" bindtap="setQuickTo" data-to="太原南站">
        <text class="quick-emoji">🚄</text>
        <text class="quick-label">去车站</text>
      </view>
      <view class="quick-item" bindtap="setQuickTo" data-to="机场">
        <text class="quick-emoji">✈️</text>
        <text class="quick-label">去机场</text>
      </view>
    </view>
  </view>

  <view style="height: 220rpx;"></view>
  <custom-tabbar current-path="/pages/taxi/taxi"></custom-tabbar>
  <ai-assistant aiEnabled="{{aiAssistantEnabled}}"></ai-assistant>
</view>
