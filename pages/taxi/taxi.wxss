/* ===== 打车服务 - 沉浸式大卡片UI ===== */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F2F6FC 0%, #FFFFFF 30%);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* 温馨提示条 */
.guide-bar {
  margin: 16rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #EEF4FC, #E6EFFB);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  border: 2rpx dashed #A8C3EF;
  box-shadow: 0 2rpx 12rpx rgba(91,141,239,0.08);
}
.guide-text {
  font-size: 30rpx;
  color: #4A7AD9;
  font-weight: 600;
}

/* 顶部安心栏 */
.top-bar {
  padding: calc(env(safe-area-inset-top) + 24rpx) 32rpx 16rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(91,141,239,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #5B8DEF;
  font-weight: 700;
  line-height: 1;
  margin-top: -4rpx;
}

.reassure {
  flex: 1;
  display: flex;
  justify-content: center;
  margin: 0 16rpx;
}

.reassure-text {
  font-size: 26rpx;
  color: #7A8BA0;
  background: #FFFFFF;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 巨型麦克风 */
.mic-card {
  margin: 24rpx 32rpx;
  padding: 48rpx 36rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(91,141,239,0.12);
  display: flex;
  align-items: center;
  border: 2rpx solid #E8EFF8;
}

.mic-btn-big {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7BA8F0, #5B8DEF);
  box-shadow: 0 12rpx 40rpx rgba(91,141,239,0.40);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 36rpx;
}

.mic-btn-big.on {
  background: linear-gradient(135deg, #E53935, #D32F2F);
  box-shadow: 0 12rpx 40rpx rgba(229,57,53,0.45);
}

.mic-ring-s {
  position: absolute;
  top: 0; left: 0;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(229,57,53,0.5);
  animation: mRing 1.2s ease-out infinite;
}
.mic-ring-s.r2 { animation-delay: 0.6s; }

@keyframes mRing {
  0%   { transform: scale(1);   opacity: 0.9; }
  100% { transform: scale(1.6); opacity: 0; }
}

.mic-emoji {
  font-size: 88rpx;
  line-height: 1;
}

.mic-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.mic-card-title {
  font-size: 44rpx;
  color: #1F3252;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.mic-card-sub {
  font-size: 30rpx;
  color: #7A8BA0;
}

/* 路线卡片 */
.route-card {
  margin: 16rpx 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(91,141,239,0.10);
  padding: 8rpx 0;
  border: 2rpx solid #E8EFF8;
}

.route-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  transition: all 0.3s ease;
}

/* AI视觉强化：字段高亮效果 */
.ai-highlight {
  background: linear-gradient(135deg, #FFF9E6, #FFF3CC);
  border-radius: 20rpx;
  transform: scale(1.02);
  box-shadow: 0 0 0 4rpx #FFD666, 0 8rpx 32rpx rgba(255,180,50,0.35);
  animation: aiHighlightPulse 1.5s ease-in-out infinite;
}

@keyframes aiHighlightPulse {
  0%, 100% { box-shadow: 0 0 0 4rpx #FFD666, 0 8rpx 24rpx rgba(255,180,50,0.3); }
  50% { box-shadow: 0 0 0 8rpx #FFC107, 0 12rpx 40rpx rgba(255,152,0,0.5); }
}

.route-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.route-dot.from-dot {
  background: linear-gradient(135deg, #7BA8F0, #5B8DEF);
  box-shadow: 0 0 0 6rpx rgba(91,141,239,0.15);
}

.route-dot.to-dot {
  background: linear-gradient(135deg, #E53935, #D32F2F);
  box-shadow: 0 0 0 6rpx rgba(229,57,53,0.15);
}

.route-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.route-label {
  font-size: 26rpx;
  color: #B5C3D4;
  margin-bottom: 6rpx;
}

.route-value {
  font-size: 38rpx;
  color: #1F3252;
  font-weight: 700;
  line-height: 1.3;
}

.route-value.placeholder {
  color: #B5C3D4;
  font-weight: 500;
  font-size: 34rpx;
}

.route-input {
  font-size: 38rpx;
  color: #1F3252;
  font-weight: 700;
  line-height: 1.3;
}

.ph-style {
  color: #B5C3D4;
  font-weight: 500;
}

.loc-btn {
  background: #EEF4FC;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.loc-text {
  font-size: 26rpx;
  color: #5B8DEF;
  font-weight: 600;
}

.route-line {
  height: 28rpx;
  margin-left: 48rpx;
  position: relative;
}

.route-line::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 4rpx;
  height: 100%;
  background: linear-gradient(180deg, #7BA8F0, #E53935);
  border-radius: 2rpx;
}

/* 预估卡片 */
.estimate-card {
  margin: 16rpx 32rpx;
  background: linear-gradient(135deg, #EEF4FC, #E8F0FA);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(91,141,239,0.08);
}

.est-main {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 12rpx;
}

.est-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.est-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #1F3252;
  line-height: 1;
}

.est-unit {
  font-size: 24rpx;
  color: #7A8BA0;
  margin-top: 8rpx;
}

.est-divider {
  width: 2rpx;
  height: 56rpx;
  background: #D5E2F2;
}

.price-item {
  flex-direction: row;
  align-items: baseline;
  gap: 4rpx;
}

.est-price-sym {
  font-size: 30rpx;
  color: #5B8DEF;
  font-weight: 700;
}

.est-price-num {
  font-size: 48rpx;
  color: #5B8DEF;
  font-weight: 800;
  line-height: 1;
}

.est-hint {
  font-size: 24rpx;
  color: #B5C3D4;
  text-align: center;
  display: block;
}

/* 叫车按钮 */
.call-btn {
  margin: 24rpx 32rpx;
  padding: 36rpx 0;
  background: linear-gradient(135deg, #7BA8F0, #5B8DEF);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(91,141,239,0.30);
  text-align: center;
}

.call-btn.disabled {
  background: #D5DCE6;
  box-shadow: none;
}

.call-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  display: block;
}

.call-btn.disabled .call-text {
  color: #9CA5B3;
}

.call-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
  display: block;
}

.call-btn.disabled .call-sub {
  color: #B5BECB;
}

/* 快捷目的地 */
.quick-section {
  margin: 24rpx 32rpx;
}

.quick-title {
  font-size: 28rpx;
  color: #7A8BA0;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.quick-grid {
  display: flex;
  gap: 16rpx;
}

.quick-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #E8EFF8;
  box-shadow: 0 4rpx 16rpx rgba(91,141,239,0.06);
}

.quick-emoji {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.quick-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F3252;
}

/* 语音弹窗 */
.voice-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-card {
  width: 85%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.voice-label {
  font-size: 32rpx;
  color: #7A8BA0;
  margin-bottom: 24rpx;
}

.voice-status {
  font-size: 36rpx;
  color: #1F3252;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
  min-height: 50rpx;
}

.voice-result {
  font-size: 32rpx;
  color: #5B8DEF;
  background: #EEF4FC;
  padding: 24rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

/* 说完了停止按钮 */
.voice-stop-btn {
  background: linear-gradient(135deg, #E53935, #D32F2F);
  padding: 32rpx 80rpx;
  border-radius: 60rpx;
  margin: 16rpx 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(229,57,53,0.35);
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.voice-stop-text {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.voice-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.voice-btn-cancel {
  flex: 1;
  background: #F2F6FC;
  padding: 28rpx 0;
  text-align: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  color: #7A8BA0;
  font-weight: 500;
}

.voice-btn-ok {
  flex: 1;
  background: linear-gradient(135deg, #7BA8F0, #5B8DEF);
  padding: 28rpx 0;
  text-align: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 700;
}
