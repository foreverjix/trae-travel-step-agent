.address-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.address-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.address-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.address-dot.start {
  background: #FF8C42;
  box-shadow: 0 0 0 8rpx rgba(255, 140, 66, 0.2);
}

.address-dot.end {
  background: #06D6A0;
  box-shadow: 0 0 0 8rpx rgba(6, 214, 160, 0.2);
}

.address-info {
  flex: 1;
}

.address-label {
  font-size: 26rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 8rpx;
}

.address-input {
  font-size: 34rpx;
  color: #2D3142;
  font-weight: bold;
  width: 100%;
}

.location-btn {
  width: 72rpx;
  height: 72rpx;
  background: #FFF2E6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.address-divider {
  height: 1rpx;
  background: #F3E5D8;
  margin-left: 48rpx;
}

.area-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.area-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 18rpx;
}

.area-tab.active {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
}

.area-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.area-text {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: bold;
}

.area-tab.active .area-text {
  color: #ffffff;
}

.estimate-card {
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-around;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.25);
}

.estimate-item {
  text-align: center;
}

.estimate-label {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 10rpx;
}

.estimate-value {
  font-size: 36rpx;
  font-weight: bold;
}

.estimate-value.price {
  font-size: 48rpx;
}

.driver-section {
  margin-bottom: 24rpx;
}

.driver-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.driver-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFF9F2;
  border-radius: 20rpx;
}

.driver-avatar {
  width: 88rpx;
  height: 88rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.driver-info {
  flex: 1;
}

.driver-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.driver-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3142;
  margin-right: 16rpx;
}

.driver-rating {
  display: flex;
  align-items: center;
}

.star {
  color: #FFB627;
  font-size: 26rpx;
}

.rating-value {
  font-size: 26rpx;
  color: #FFB627;
  margin-left: 4rpx;
  font-weight: bold;
}

.driver-trips {
  font-size: 26rpx;
  color: #6B7280;
}

.driver-distance {
  font-size: 28rpx;
  color: #FF8C42;
  font-weight: bold;
}

.remote-section {
  margin-bottom: 24rpx;
}

.remote-notice {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #FFF4E0;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.remote-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.remote-text {
  flex: 1;
}

.remote-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #9A5B2E;
  display: block;
  margin-bottom: 8rpx;
}

.remote-desc {
  font-size: 28rpx;
  color: #9A5B2E;
  opacity: 0.8;
}

.remote-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(255, 140, 66, 0.1);
  z-index: 100;
}

.footer-btn {
  border-radius: 50rpx;
  font-size: 36rpx;
  padding: 32rpx;
}
