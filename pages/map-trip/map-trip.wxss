.address-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
  position: relative;
}

.address-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.address-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.address-dot.start {
  background: #FF8C42;
  box-shadow: 0 0 0 8rpx rgba(255, 140, 66, 0.2);
}

.address-dot.end {
  background: #06D6A0;
  box-shadow: 0 0 0 8rpx rgba(6, 214, 160, 0.2);
}

.address-input {
  flex: 1;
  font-size: 34rpx;
  color: #2D3142;
  font-weight: bold;
}

.address-divider {
  height: 1rpx;
  background: #F3E5D8;
  margin-left: 48rpx;
}

.swap-btn {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFF2E6;
  color: #FF8C42;
  border-radius: 30rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.date-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date-label {
  font-size: 30rpx;
  color: #6B7280;
  font-weight: bold;
}

.date-value {
  font-size: 34rpx;
  color: #FF8C42;
  font-weight: bold;
}

.map-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.map-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.map-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3142;
}

.map-distance {
  font-size: 26rpx;
  color: #FF8C42;
  font-weight: bold;
  background: #FFF2E6;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.real-map-container {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F3F4F6;
}

.map-image {
  width: 100%;
  height: 100%;
  display: block;
}

.plans-section {
  margin-bottom: 24rpx;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.plan-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
  position: relative;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
  box-sizing: border-box;
  overflow: hidden;
}

.plan-card:active {
  border-color: #FF8C42;
}

.plan-card.selected {
  border-color: #FF8C42;
  background: #FFFDFB;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.15);
}

.plan-badge {
  position: absolute;
  top: 0;
  right: 28rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-top: 8rpx;
}

.plan-time {
  display: flex;
  align-items: center;
}

.time-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.time-text {
  font-size: 30rpx;
  color: #2D3142;
  font-weight: bold;
}

.plan-price {
  display: flex;
  align-items: baseline;
}

.price-unit {
  font-size: 28rpx;
  color: #FF8C42;
  font-weight: bold;
}

.price-value {
  font-size: 48rpx;
  color: #FF8C42;
  font-weight: bold;
  margin: 0 4rpx;
}

.price-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.plan-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.plan-step {
  display: flex;
  align-items: flex-start;
  background: #FFF9F2;
  border-radius: 20rpx;
  padding: 20rpx;
}

.step-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-info {
  flex: 1;
}

.step-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 6rpx;
}

.step-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.step-provider {
  display: inline-block;
  background: linear-gradient(135deg, #FFF2E6 0%, #FFE4D1 100%);
  color: #FF8C42;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 12rpx;
  font-weight: bold;
  border: 1rpx solid #FFD4B8;
}

.step-detail {
  font-size: 26rpx;
  color: #6B7280;
}

.plan-action {
  margin-top: 20rpx;
  box-sizing: border-box;
}

.plan-providers {
  background: linear-gradient(135deg, #FFF9F2 0%, #FFF2E6 100%);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #FFE4D1;
}

.provider-label {
  font-size: 26rpx;
  color: #9A5B2E;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.provider-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.provider-chip {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #FFD4B8;
  border-radius: 32rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 66, 0.1);
}

.provider-chip:active {
  background: #FFF2E6;
  border-color: #FF8C42;
}

.chip-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.chip-text {
  font-size: 26rpx;
  color: #FF8C42;
  font-weight: bold;
}

.plan-btn {
  border-radius: 40rpx;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
  display: block;
}
