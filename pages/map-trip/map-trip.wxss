/* ===== 行程规划页 - 简洁风格 ===== */
.container {
  padding: 0;
  background: #F5F0EB;
  min-height: 100vh;
}

/* ===== 头部 ===== */
.header {
  background: #5B8DEF;
  padding: calc(env(safe-area-inset-top) + 40rpx) 32rpx 36rpx;
  display: flex;
  align-items: center;
}

.header-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
  margin-right: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* ===== 地址输入 ===== */
.address-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 8rpx 0;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.input-label {
  width: 48rpx;
  font-size: 30rpx;
  color: #7A8BA0;
  flex-shrink: 0;
  font-weight: 500;
}

.input-field {
  flex: 1;
  font-size: 34rpx;
  color: #2C3E5A;
  min-width: 0;
  font-weight: 600;
}

.link-btn {
  font-size: 28rpx;
  color: #5B8DEF;
  padding: 8rpx 0 8rpx 20rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.divider {
  height: 1rpx;
  background: #F5F0EB;
  margin: 0 32rpx;
}

/* ===== 搜索结果 ===== */
.search-results {
  background: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.list-title {
  font-size: 30rpx;
  color: #2C3E5A;
  font-weight: 600;
}

.list-count {
  font-size: 26rpx;
  color: #B5C3D4;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-main {
  flex: 1;
}

.list-item-title {
  font-size: 32rpx;
  color: #2C3E5A;
  display: block;
  font-weight: 600;
}

.list-item-sub {
  font-size: 26rpx;
  color: #B5C3D4;
  margin-top: 4rpx;
  display: block;
}

.list-item-arrow {
  font-size: 32rpx;
  color: #B5C3D4;
  margin-left: 16rpx;
}

/* ===== 日期选择 ===== */
.date-row {
  margin: 0 24rpx 24rpx;
}

.date-card {
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 16rpx;
}

.date-label {
  font-size: 30rpx;
  color: #7A8BA0;
  font-weight: 500;
}

.date-value {
  font-size: 32rpx;
  color: #2C3E5A;
  font-weight: 600;
}

/* ===== 查询按钮 ===== */
.search-btn {
  margin: 0 24rpx 24rpx;
  background: #5B8DEF;
  color: #FFFFFF;
  padding: 32rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 16rpx;
}

/* ===== 地图 ===== */
.map-section {
  background: #FFFFFF;
  margin: 0 24rpx 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
}

.map-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.map-title {
  font-size: 30rpx;
  color: #2C3E5A;
  font-weight: 600;
  flex: 1;
}

.map-sub {
  font-size: 26rpx;
  color: #7A8BA0;
}

/* ===== 空状态 ===== */
.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #7A8BA0;
  margin-bottom: 12rpx;
}

.empty-sub {
  display: block;
  font-size: 26rpx;
  color: #B5C3D4;
}

/* ===== 方案列表 ===== */
.plans-wrapper {
  padding: 0 24rpx;
}

.loading-box {
  background: #FFFFFF;
  padding: 80rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #7A8BA0;
}

.result-count {
  font-size: 28rpx;
  color: #7A8BA0;
  margin-bottom: 16rpx;
  display: block;
}

.plan-block {
  background: #FFFFFF;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 推荐标签 */
.plan-tags {
  padding: 16rpx 24rpx 0;
  display: flex;
  gap: 12rpx;
}

.plan-tag {
  font-size: 24rpx;
  color: #FFFFFF;
  background: #5B8DEF;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.plan-tag.cheap {
  background: #66BB6A;
}

/* 推荐理由 */
.plan-reason {
  background: #FFF8F5;
  padding: 12rpx 24rpx;
  margin: 12rpx 24rpx 0;
  border-radius: 12rpx;
  border-left: 4rpx solid #5B8DEF;
}

.reason-text {
  font-size: 26rpx;
  color: #7A8BA0;
  line-height: 1.5;
}

/* 时间信息 */
.plan-time-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.time-cell {
  flex: 1;
  text-align: center;
}

.time-label {
  display: block;
  font-size: 24rpx;
  color: #B5C3D4;
  margin-bottom: 6rpx;
}

.time-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E5A;
}

/* 汇总信息 */
.plan-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.summary-cell {
  display: flex;
  align-items: center;
}

.summary-label {
  font-size: 24rpx;
  color: #B5C3D4;
  margin-right: 12rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E5A;
}

/* 分段行程 */
.segments-list {
  padding: 16rpx 24rpx;
}

.seg-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
}

.seg-row:last-child {
  border-bottom: none;
}

.seg-label-col {
  width: 112rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.seg-label {
  display: inline-block;
  font-size: 26rpx;
  color: #7A8BA0;
  padding: 8rpx 14rpx;
  background: #EBF0F8;
  border-radius: 8rpx;
  font-weight: 600;
}

.seg-label.train {
  color: #FFFFFF;
  background: #5B8DEF;
}

.seg-label.walk {
  color: #7A8BA0;
  background: #F5F0EB;
}

.seg-label.bus {
  color: #FFFFFF;
  background: #5B8DEF;
}

.seg-label.taxi {
  color: #FFFFFF;
  background: #5B8DEF;
}

.seg-label.subway {
  color: #FFFFFF;
  background: #5B8DEF;
}

.seg-label.done {
  color: #FFFFFF;
  background: #66BB6A;
}

.seg-body {
  flex: 1;
  min-width: 0;
}

.seg-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E5A;
  margin-bottom: 8rpx;
}

.seg-desc {
  display: block;
  font-size: 28rpx;
  color: #4A5568;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.seg-loc {
  display: block;
  font-size: 26rpx;
  color: #7A8BA0;
  margin-bottom: 10rpx;
}

.info-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.info-key {
  font-size: 24rpx;
  color: #B5C3D4;
  margin-right: 8rpx;
}

.info-val {
  font-size: 26rpx;
  color: #2C3E5A;
  margin-right: 24rpx;
  font-weight: 500;
}

.lines-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.line-tag {
  font-size: 24rpx;
  color: #2C3E5A;
  background: #EBF0F8;
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
}

/* 切换按钮 */
.toggle-row {
  display: flex;
  border: 1rpx solid #E8ECF2;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.toggle-btn {
  flex: 1;
  padding: 12rpx 0;
  text-align: center;
  background: #FFFFFF;
}

.toggle-btn.on {
  background: #5B8DEF;
}

.toggle-text {
  font-size: 28rpx;
  color: #7A8BA0;
}

.toggle-btn.on .toggle-text {
  color: #FFFFFF;
}

/* 操作按钮 */
.seg-btn-row {
  margin-top: 12rpx;
}

.seg-btn {
  display: inline-block;
  padding: 14rpx 28rpx;
  border: 1rpx solid #E8ECF2;
  margin-right: 16rpx;
  border-radius: 12rpx;
}

.seg-btn.primary {
  background: #5B8DEF;
  border-color: #5B8DEF;
}

.seg-btn.disabled {
  background: #F5F0EB;
  border-color: #E8ECF2;
}

.seg-btn-text {
  font-size: 28rpx;
  color: #2C3E5A;
  font-weight: 500;
}

.seg-btn.primary .seg-btn-text {
  color: #FFFFFF;
}

.seg-btn.disabled .seg-btn-text {
  color: #B5C3D4;
}

/* 底部价格和确认 */
.plan-footer {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #F5F0EB;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-block {
  display: flex;
  align-items: flex-end;
}

.price-label {
  font-size: 26rpx;
  color: #B5C3D4;
  margin-right: 12rpx;
  margin-bottom: 4rpx;
}

.price-value-row {
  display: flex;
  align-items: flex-end;
}

.price-symbol {
  font-size: 30rpx;
  color: #2C3E5A;
  font-weight: 600;
  margin-right: 2rpx;
  margin-bottom: 6rpx;
}

.price-value-num {
  font-size: 44rpx;
  color: #2C3E5A;
  font-weight: 700;
  line-height: 1;
}

.price-unit {
  font-size: 26rpx;
  color: #7A8BA0;
  margin-left: 4rpx;
  margin-bottom: 4rpx;
}

.confirm-all {
  background: #5B8DEF;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
}

.confirm-all-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 空方案 */
.empty-plans {
  background: #FFFFFF;
  padding: 80rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
}

/* 底部提示 */
.foot-tip {
  padding: 24rpx 32rpx;
  text-align: center;
}

.foot-tip-text {
  font-size: 26rpx;
  color: #B5C3D4;
}
