.page {
  min-height: 100vh;
  background: #F5F8FC;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ===== 头部 ===== */
.header {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 44rpx) 32rpx 48rpx;
}

.header-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 14rpx;
  flex-shrink: 0;
  margin-bottom: 16rpx;
}

.header-back text {
  font-size: 44rpx;
  color: #ffffff;
  font-weight: bold;
}

.header-info {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

/* ===== 主体 ===== */
.body {
  padding: 24rpx 32rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  padding: 24rpx 0;
}

.form-item:first-child {
  padding-top: 0;
}

.form-item:last-child {
  padding-bottom: 0;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

/* 输入框外层容器 */
.input-box {
  background: #FAFAFA;
  border-radius: 10rpx;
  border: 1rpx solid #F0F0F0;
  padding: 18rpx 24rpx;
}

/* textarea 替代 input，避免原生 input 高度裁剪问题 */
.ta {
  width: 100% !important;
  font-size: 32rpx !important;
  color: #333 !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  box-sizing: border-box;
}

.ph {
  color: #999;
  font-size: 32rpx;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 32rpx;
  color: #333;
}

.arrow {
  font-size: 40rpx;
  color: #5B8DEF;
  font-weight: 300;
  flex-shrink: 0;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-box {
  flex: 1;
}

.code-btn {
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  padding: 22rpx 20rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
  text-align: center;
}

.code-btn.disabled {
  background: #F0F0F0;
  color: #999;
}

/* ===== 主按钮 ===== */
.main-btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #5B8DEF, #4A7AD9);
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(91, 141, 239, 0.3);
}

.main-btn text {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

/* ===== 提示 ===== */
.tips {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  border: 1rpx solid #F0F0F0;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
  padding: 4rpx 0;
}
