.bind-section {
  padding-bottom: 32rpx;
}

.empty-state {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 32rpx;
}

.empty-state .btn-primary {
  width: 100%;
}

/* 父母列表 */
.parent-list {
  margin-bottom: 32rpx;
}

.list-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.parent-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.08);
}

.parent-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.parent-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C42 0%, #FFB627 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: bold;
}

.parent-detail {
  flex: 1;
}

.parent-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 6rpx;
}

.parent-relation {
  font-size: 26rpx;
  color: #FF8C42;
  display: block;
}

.parent-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  background: #FFF9F2;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.97);
  background: #FFE9D6;
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 24rpx;
  color: #2D3142;
  font-weight: bold;
}

.parent-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #F3F4F6;
}

.bind-time {
  font-size: 24rpx;
  color: #6B7280;
}

.delete-btn {
  font-size: 24rpx;
  color: #EF476F;
  padding: 8rpx 16rpx;
}

.add-parent {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 2rpx dashed #FFB627;
  transition: all 0.2s ease;
}

.add-parent:active {
  background: #FFF9F2;
}

.add-icon {
  font-size: 48rpx;
  color: #FF8C42;
  font-weight: bold;
}

.add-text {
  font-size: 32rpx;
  color: #FF8C42;
  font-weight: bold;
}

/* 提示 */
.tips-section {
  padding-bottom: 32rpx;
}

.tips-card {
  background: #FFF9F2;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  gap: 20rpx;
  border: 2rpx solid #FFE9D6;
}

.tips-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.tips-content {
  flex: 1;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2D3142;
  display: block;
  margin-bottom: 8rpx;
}

.tips-desc {
  font-size: 26rpx;
  color: #6B7280;
  display: block;
  line-height: 1.6;
}