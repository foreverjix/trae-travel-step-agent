<view class="container">
  <view class="header-gradient">
    <text class="page-title text-white">{{parentName}}的行程</text>
    <text class="page-subtitle text-white">查看父母的出行记录</text>
  </view>

  <view class="trips-list" wx:if="{{trips.length > 0}}">
    <view class="trip-card" wx:for="{{trips}}" wx:key="id" bindtap="viewDetail" data-trip="{{item}}">
      <view class="trip-header">
        <text class="trip-date">{{item.date}}</text>
        <view class="trip-status" style="color: {{getStatusColor(item.status)}}">
          {{getStatusText(item.status)}}
        </view>
      </view>
      
      <view class="trip-main">
        <text class="trip-title">{{item.title}}</text>
        <text class="trip-desc">{{item.desc}}</text>
      </view>

      <view class="trip-steps-preview">
        <view class="step-preview" wx:for="{{item.steps}}" wx:key="name" wx:for-item="step">
          <text class="step-icon">{{step.type === 'taxi' ? '🚕' : step.type === 'train' ? '🚄' : step.type === 'flight' ? '✈️' : '🚌'}}</text>
          <text class="step-time">{{step.time}}</text>
        </view>
      </view>

      <view class="trip-footer">
        <text class="trip-price">¥{{item.totalPrice}}</text>
        <text class="trip-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无行程记录</text>
    <text class="empty-desc">{{parentName}}还没有出行记录，您可以帮父母规划行程</text>
  </view>
</view>