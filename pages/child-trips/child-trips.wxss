.header-gradient {
  background: linear-gradient(135deg, #7BA8F0 0%, #5B8DEF 100%);
  padding: calc(env(safe-area-inset-top) + 56rpx) 32rpx 48rpx;
}

.trips-list {
  margin-bottom: 32rpx;
}

.trip-card {
  background: #ffffff;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.trip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.trip-date {
  font-size: 30rpx;
  color: #7A8BA0;
}

.trip-status {
  font-size: 28rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  background: #EBF0F8;
  border-radius: 4rpx;
}

.trip-main {
  margin-bottom: 20rpx;
}

.trip-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 8rpx;
}

.trip-desc {
  font-size: 30rpx;
  color: #7A8BA0;
  display: block;
}

.trip-steps-preview {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #EBF0F8;
  border: 1rpx solid #E8ECF2;
  border-radius: 12rpx;
}

.step-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-icon-text {
  font-size: 28rpx;
  color: #2C3E5A;
  font-weight: bold;
}

.step-time {
  font-size: 26rpx;
  color: #7A8BA0;
}

.trip-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8ECF2;
}

.trip-price {
  font-size: 34rpx;
  color: #2C3E5A;
  font-weight: bold;
}

.trip-arrow {
  font-size: 40rpx;
  color: #7A8BA0;
}

.empty-state {
  background: #ffffff;
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1rpx solid #E8ECF2;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(91, 141, 239, 0.08);
}

.empty-icon-text {
  font-size: 32rpx;
  color: #7A8BA0;
  display: block;
  margin-bottom: 24rpx;
  font-weight: bold;
}

.empty-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #2C3E5A;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 30rpx;
  color: #7A8BA0;
  display: block;
}
